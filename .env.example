# Insightful Health - Environment Variables
# This file serves as a template. Copy to .env.local and fill in your actual values.
# .env.local is git-ignored and should never be committed.

# ============================================================================
# PUBLIC VARIABLES (Safe to expose to client)
# Use PUBLIC_ prefix - these will be available in client-side code
# ============================================================================

# Site Configuration
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SITE_NAME=Insightful Health
PUBLIC_SITE_DESCRIPTION=Public health data analytics and insights

# PocketBase Configuration
PUBLIC_POCKETBASE_URL=http://localhost:8090

# Google Analytics
PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================================================
# PRIVATE VARIABLES (Only available on server)
# Do NOT use PUBLIC_ prefix - these stay secure on the backend
# ============================================================================

# PocketBase Admin Credentials
PRIVATE_POCKETBASE_ADMIN_EMAIL=admin@insightfulhealth.local
PRIVATE_POCKETBASE_ADMIN_PASSWORD=admin123456

# MailerLite API
PRIVATE_MAILERLITE_API_KEY=your_mailerlite_api_key_here

# OAuth Credentials (GitHub)
PRIVATE_OAUTH_GITHUB_CLIENT_ID=your_github_client_id
PRIVATE_OAUTH_GITHUB_CLIENT_SECRET=your_github_client_secret
PRIVATE_OAUTH_GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github

# OAuth Credentials (Google)
PRIVATE_OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
PRIVATE_OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
PRIVATE_OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# OAuth Credentials (Facebook)
PRIVATE_OAUTH_FACEBOOK_APP_ID=your_facebook_app_id
PRIVATE_OAUTH_FACEBOOK_APP_SECRET=your_facebook_app_secret
PRIVATE_OAUTH_FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/callback/facebook

# JWT Configuration
PRIVATE_JWT_SECRET=your_jwt_secret_key_change_in_production
PRIVATE_JWT_EXPIRATION=7d

# Database & Backup
PRIVATE_POCKETBASE_BACKUP_DIR=./backups
PRIVATE_DATABASE_ENCRYPTION_KEY=your_encryption_key_for_sensitive_data

# ============================================================================
# DEVELOPMENT-ONLY VARIABLES
# ============================================================================

# Set to true to enable debug logging
DEBUG=false

# Set to true to seed database with sample data
SEED_DATABASE=false
