# Insightful Health - Local Development Environment Variables
# This file is git-ignored and should NOT be committed
# Keep your real credentials and secrets here

# ============================================================================
# PUBLIC VARIABLES (Safe to expose to client)
# ============================================================================

PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SITE_NAME=Insightful Health
PUBLIC_SITE_DESCRIPTION=Public health data analytics and insights

# Local PocketBase instance
PUBLIC_POCKETBASE_URL=http://localhost:8090

# Google Analytics (optional - leave as placeholder for local dev)
PUBLIC_GA_ID=G-DEV0000000

# ============================================================================
# PRIVATE VARIABLES (Server-side only)
# ============================================================================

# PocketBase Admin Credentials (local development)
PRIVATE_POCKETBASE_ADMIN_EMAIL=admin@insightfulhealth.local
PRIVATE_POCKETBASE_ADMIN_PASSWORD=admin123456

# MailerLite API (optional for local dev - request from admin)
PRIVATE_MAILERLITE_API_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OAuth Credentials - GitHub (local development)
PRIVATE_OAUTH_GITHUB_CLIENT_ID=dev_github_client_id_xxxxx
PRIVATE_OAUTH_GITHUB_CLIENT_SECRET=dev_github_client_secret_xxxxx
PRIVATE_OAUTH_GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github

# OAuth Credentials - Google (local development)
PRIVATE_OAUTH_GOOGLE_CLIENT_ID=dev_google_client_id_xxxxx.apps.googleusercontent.com
PRIVATE_OAUTH_GOOGLE_CLIENT_SECRET=dev_google_client_secret_xxxxx
PRIVATE_OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# OAuth Credentials - Facebook (local development)
PRIVATE_OAUTH_FACEBOOK_APP_ID=dev_facebook_app_id_xxxxx
PRIVATE_OAUTH_FACEBOOK_APP_SECRET=dev_facebook_app_secret_xxxxx
PRIVATE_OAUTH_FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/callback/facebook

# JWT Configuration
PRIVATE_JWT_SECRET=dev_jwt_secret_key_change_in_production_xxxxxxxxxxxxxxxx
PRIVATE_JWT_EXPIRATION=7d

# Database & Backup
PRIVATE_POCKETBASE_BACKUP_DIR=./backups
PRIVATE_DATABASE_ENCRYPTION_KEY=dev_encryption_key_xxxxxxxxxxxxxxxx

# Development Settings
DEBUG=true
SEED_DATABASE=false
