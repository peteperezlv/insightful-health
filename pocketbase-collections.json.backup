          "system": false,
          "required": false,
          "options": {
            "collectionId": "users_collection",
            "maxSelect": 1
          }
        },
        {
          "id": "approvedAt_field",
          "name": "approvedAt",
          "type": "date",
          "system": false,
          "required": false,
          "options": {}
        }
      ],
      "indexes": [
        "CREATE INDEX idx_posts_authorId ON posts(authorId)",
        "CREATE UNIQUE INDEX idx_posts_slug ON posts(slug)",
        "CREATE INDEX idx_posts_status_publishedAt ON posts(status, publishedAt DESC)",
        "CREATE INDEX idx_posts_categoryId ON posts(categoryId)",
        "CREATE INDEX idx_posts_viewCount ON posts(viewCount DESC)",
        "CREATE INDEX idx_posts_isFeatured ON posts(isFeatured)",
        "CREATE INDEX idx_posts_created ON posts(created DESC)"
      ]
    },
    {
      "id": "comments_collection",
      "name": "comments",
      "type": "base",
      "system": false,
      "listRule": "status = 'approved' || @request.auth.role = 'admin'",
      "viewRule": "status = 'approved' || @request.auth.role = 'admin' || authorId = @request.auth.id",
      "createRule": "@request.auth.id != ''",
      "updateRule": "authorId = @request.auth.id || @request.auth.role = 'admin'",
      "deleteRule": "authorId = @request.auth.id || @request.auth.role = 'admin'",
      "fields": [
        {
          "id": "postId_field",
          "name": "postId",
          "type": "relation",
          "system": false,
          "required": true,
          "options": {
            "collectionId": "posts_collection",
            "maxSelect": 1
          }
        },
        {
          "id": "content_field",
          "name": "content",
          "type": "text",
          "system": false,
          "required": true,
          "options": {
            "min": 1,
            "max": 5000
          }
        },
        {
          "id": "authorId_field",
          "name": "authorId",
          "type": "relation",
          "system": false,
          "required": false,
          "options": {
            "collectionId": "users_collection",
            "maxSelect": 1
          }
        },
        {
          "id": "authorName_field",
          "name": "authorName",
          "type": "text",
          "system": false,
          "required": false,
          "options": {}
        },
        {
          "id": "authorEmail_field",
          "name": "authorEmail",
          "type": "email",
          "system": false,
          "required": false,
          "options": {}
        },
        {
          "id": "parentCommentId_field",
          "name": "parentCommentId",
          "type": "relation",
          "system": false,
          "required": false,
          "options": {
            "collectionId": "comments_collection",
            "maxSelect": 1
          }
        },
        {
          "id": "status_field",
          "name": "status",
          "type": "select",
          "system": false,
          "required": true,
          "options": {
            "maxSelect": 1,
            "values": ["pending", "approved", "rejected", "spam"]
          }
        },
        {
          "id": "approvedBy_field",
          "name": "approvedBy",
          "type": "relation",
          "system": false,
          "required": false,
          "options": {
            "collectionId": "users_collection",
            "maxSelect": 1
          }
        },
        {
          "id": "approvedAt_field",
          "name": "approvedAt",
          "type": "date",
          "system": false,
          "required": false,
          "options": {}
        },
        {
          "id": "rejectionReason_field",
          "name": "rejectionReason",
          "type": "text",
          "system": false,
          "required": false,
          "options": {}
        },
        {
          "id": "isEdited_field",
          "name": "isEdited",
          "type": "bool",
          "system": false,
          "required": false,
          "options": {}
        },
        {
          "id": "editedAt_field",
          "name": "editedAt",
          "type": "date",
          "system": false,
          "required": false,
          "options": {}
        },
        {
          "id": "editHistory_field",
          "name": "editHistory",
          "type": "json",
          "system": false,
          "required": false,
          "options": {}
        },
        {
          "id": "ipAddress_field",
          "name": "ipAddress",
          "type": "text",
          "system": false,
          "required": true,
          "options": {}
        },
        {
          "id": "userAgent_field",
          "name": "userAgent",
          "type": "text",
          "system": false,
          "required": false,
          "options": {}
        },
        {
          "id": "likeCount_field",
          "name": "likeCount",
          "type": "number",
          "system": false,
          "required": false,
          "options": {
            "min": 0
          }
        }
      ],
      "indexes": [
        "CREATE INDEX idx_comments_postId ON comments(postId)",
        "CREATE INDEX idx_comments_authorId ON comments(authorId)",
        "CREATE INDEX idx_comments_parentCommentId ON comments(parentCommentId)",
        "CREATE INDEX idx_comments_status ON comments(status)",
        "CREATE INDEX idx_comments_created ON comments(created DESC)",
        "CREATE INDEX idx_comments_postId_status ON comments(postId, status)"
      ]
    },
