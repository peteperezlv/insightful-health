---
/**
 * Archive Page
 * Display all posts grouped by year and month
 */

export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getPocketBase } from '../lib/pocketbase';

// Fetch all published posts
const pb = getPocketBase();
let posts: any[] = [];

try {
  const results = await pb.collection('posts').getFullList({
    filter: 'status = "published"',
    sort: '-created',
    expand: 'authorId,categoryId',
  });
  posts = results;
} catch (error) {
  console.error('Error fetching posts:', error);
}

// Group posts by year and month
interface PostsByMonth {
  [year: string]: {
    [month: string]: any[];
  };
}

const postsByYearMonth: PostsByMonth = {};

posts.forEach((post) => {
  const date = new Date(post.created);
  const year = date.getFullYear().toString();
  const month = date.toLocaleString('en-US', { month: 'long' });

  if (!postsByYearMonth[year]) {
    postsByYearMonth[year] = {};
  }
  if (!postsByYearMonth[year][month]) {
    postsByYearMonth[year][month] = [];
  }
  postsByYearMonth[year][month].push(post);
});

// Sort years descending
const years = Object.keys(postsByYearMonth).sort((a, b) => parseInt(b) - parseInt(a));

// Format date
const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<Layout
  title="Archive | Insightful Health"
  description="Browse all posts by date. Explore our complete archive of public health insights and articles."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Page Header -->
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Archive</h1>
      <p class="text-lg text-gray-600">
        Browse all {posts.length} posts organized by publication date
      </p>
    </div>

    {
      years.length === 0 ? (
        <div class="bg-white rounded-lg shadow-sm p-12 text-center">
          <svg
            class="mx-auto h-16 w-16 text-gray-400 mb-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
          <h3 class="text-lg font-medium text-gray-900 mb-2">No posts yet</h3>
          <p class="text-gray-500">Check back later for new content!</p>
        </div>
      ) : (
        <div class="space-y-12">
          {years.map((year) => (
            <section>
              <h2 class="text-3xl font-bold text-gray-900 mb-6 pb-2 border-b-2 border-emerald-600">
                {year}
              </h2>

              <div class="space-y-8">
                {Object.keys(postsByYearMonth[year])
                  .sort((a, b) => {
                    const monthOrder = [
                      'January',
                      'February',
                      'March',
                      'April',
                      'May',
                      'June',
                      'July',
                      'August',
                      'September',
                      'October',
                      'November',
                      'December',
                    ];
                    return monthOrder.indexOf(b) - monthOrder.indexOf(a);
                  })
                  .map((month) => (
                    <div>
                      <h3 class="text-xl font-semibold text-gray-800 mb-4">
                        {month}
                      </h3>

                      <div class="space-y-3 pl-6 border-l-2 border-gray-200">
                        {postsByYearMonth[year][month].map((post: any) => (
                          <article class="group">
                            <div class="flex items-start gap-4">
                              <time
                                datetime={post.created}
                                class="text-sm text-gray-500 min-w-[80px] pt-1"
                              >
                                {formatDate(post.created).split(',')[0].split(' ')[1]}{' '}
                                {formatDate(post.created).split(',')[0].split(' ')[0]}
                              </time>

                              <div class="flex-1">
                                <h4 class="text-lg font-medium">
                                  <a
                                    href={`/posts/${post.slug}`}
                                    class="text-gray-900 hover:text-emerald-600 transition-colors group-hover:underline"
                                  >
                                    {post.title}
                                  </a>
                                </h4>

                                {post.excerpt && (
                                  <p class="text-gray-600 text-sm mt-1 line-clamp-2">
                                    {post.excerpt}
                                  </p>
                                )}

                                <div class="flex flex-wrap items-center gap-3 mt-2 text-xs text-gray-500">
                                  {post.expand?.authorId && (
                                    <span class="flex items-center gap-1">
                                      <svg
                                        class="w-3 h-3"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                      >
                                        <path
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                        />
                                      </svg>
                                      {post.expand.authorId.fullName ||
                                        post.expand.authorId.username}
                                    </span>
                                  )}

                                  {post.expand?.categoryId && (
                                    <a
                                      href={`/category/${post.expand.categoryId.slug}`}
                                      class="flex items-center gap-1 hover:text-emerald-600 transition-colors"
                                    >
                                      <svg
                                        class="w-3 h-3"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                      >
                                        <path
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                                        />
                                      </svg>
                                      {post.expand.categoryId.name}
                                    </a>
                                  )}

                                  {post.viewCount > 0 && (
                                    <span class="flex items-center gap-1">
                                      <svg
                                        class="w-3 h-3"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                      >
                                        <path
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                        />
                                        <path
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                        />
                                      </svg>
                                      {post.viewCount}
                                    </span>
                                  )}

                                  {post.commentCount > 0 && (
                                    <span class="flex items-center gap-1">
                                      <svg
                                        class="w-3 h-3"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                      >
                                        <path
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
                                        />
                                      </svg>
                                      {post.commentCount}
                                    </span>
                                  )}
                                </div>
                              </div>
                            </div>
                          </article>
                        ))}
                      </div>
                    </div>
                  ))}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
