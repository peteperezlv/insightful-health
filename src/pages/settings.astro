---
/**
 * User Settings Page
 * Manage account settings, profile, and preferences
 */

export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getUserDisplayName } from '../lib/session';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/auth/login');
}
---

<Layout title="Settings">
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Settings</h1>
        <p class="mt-2 text-sm text-gray-600">
          Manage your account settings and preferences.
        </p>
      </div>

      <!-- Tabs -->
      <div class="border-b border-gray-200 mb-6">
        <nav class="-mb-px flex space-x-8" aria-label="Tabs">
          <a
            href="#account"
            class="tab-link border-emerald-500 text-emerald-600 border-b-2 py-4 px-1 text-sm font-medium"
          >
            Account
          </a>
          <a
            href="#profile"
            class="tab-link border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 border-b-2 py-4 px-1 text-sm font-medium"
          >
            Profile
          </a>
          <a
            href="#security"
            class="tab-link border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 border-b-2 py-4 px-1 text-sm font-medium"
          >
            Security
          </a>
          <a
            href="#preferences"
            class="tab-link border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 border-b-2 py-4 px-1 text-sm font-medium"
          >
            Preferences
          </a>
        </nav>
      </div>

      <!-- Account Tab -->
      <div id="account" class="tab-content">
        <div class="bg-white shadow rounded-lg p-6">
          <h2 class="text-lg font-medium text-gray-900 mb-6">
            Account Information
          </h2>

          <form class="space-y-6" method="POST" action="/api/user/update">
            <!-- Email -->
            <div>
              <label
                for="email"
                class="block text-sm font-medium text-gray-700"
              >
                Email address
              </label>
              <div class="mt-1 flex rounded-md shadow-sm">
                <input
                  type="email"
                  name="email"
                  id="email"
                  value={user.email}
                  class="focus:ring-emerald-500 focus:border-emerald-500 flex-1 block w-full rounded-md sm:text-sm border-gray-300"
                  readonly
                />
                {
                  user.verified ? (
                    <span class="ml-3 inline-flex items-center px-3 rounded-md bg-green-50 text-green-700 text-sm">
                      <svg
                        class="mr-1 w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      Verified
                    </span>
                  ) : (
                    <span class="ml-3 inline-flex items-center px-3 rounded-md bg-yellow-50 text-yellow-700 text-sm">
                      Not verified
                    </span>
                  )
                }
              </div>
              <p class="mt-2 text-sm text-gray-500">
                Your email address is managed through your authentication
                provider.
              </p>
            </div>

            <!-- Username -->
            <div>
              <label
                for="username"
                class="block text-sm font-medium text-gray-700"
              >
                Username
              </label>
              <input
                type="text"
                name="username"
                id="username"
                value={user.username || ''}
                class="mt-1 focus:ring-emerald-500 focus:border-emerald-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md"
                placeholder="Choose a username"
              />
              <p class="mt-2 text-sm text-gray-500">
                Your username will be displayed on your profile and posts.
              </p>
            </div>

            <!-- Full Name -->
            <div>
              <label
                for="fullName"
                class="block text-sm font-medium text-gray-700"
              >
                Full name
              </label>
              <input
                type="text"
                name="fullName"
                id="fullName"
                value={user.fullName || ''}
                class="mt-1 focus:ring-emerald-500 focus:border-emerald-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md"
                placeholder="Enter your full name"
              />
            </div>

            <!-- Save Button -->
            <div class="flex justify-end">
              <button
                type="submit"
                class="ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500"
              >
                Save changes
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Profile Tab -->
      <div id="profile" class="tab-content hidden">
        <div class="bg-white shadow rounded-lg p-6">
          <h2 class="text-lg font-medium text-gray-900 mb-6">Public Profile</h2>

          <form
            class="space-y-6"
            method="POST"
            action="/api/user/update-profile"
          >
            <!-- Avatar -->
            <div>
              <label class="block text-sm font-medium text-gray-700">
                Profile photo
              </label>
              <div class="mt-1 flex items-center">
                {
                  user.avatar ? (
                    <img
                      src={user.avatar}
                      alt={getUserDisplayName(user)}
                      class="h-16 w-16 rounded-full"
                    />
                  ) : (
                    <div class="h-16 w-16 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xl font-bold">
                      {getUserDisplayName(user).substring(0, 2).toUpperCase()}
                    </div>
                  )
                }
                <button
                  type="button"
                  class="ml-5 bg-white py-2 px-3 border border-gray-300 rounded-md shadow-sm text-sm leading-4 font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500"
                >
                  Change
                </button>
              </div>
            </div>

            <!-- Bio -->
            <div>
              <label for="bio" class="block text-sm font-medium text-gray-700">
                Bio
              </label>
              <textarea
                id="bio"
                name="bio"
                rows="4"
                class="mt-1 focus:ring-emerald-500 focus:border-emerald-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md"
                placeholder="Write a short bio about yourself..."></textarea>
              <p class="mt-2 text-sm text-gray-500">
                Brief description for your profile. URLs are hyperlinked.
              </p>
            </div>

            <!-- Website -->
            <div>
              <label
                for="website"
                class="block text-sm font-medium text-gray-700"
              >
                Website
              </label>
              <input
                type="url"
                name="website"
                id="website"
                class="mt-1 focus:ring-emerald-500 focus:border-emerald-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md"
                placeholder="https://example.com"
              />
            </div>

            <!-- Social Links -->
            <div>
              <label
                for="twitter"
                class="block text-sm font-medium text-gray-700"
              >
                Twitter
              </label>
              <input
                type="text"
                name="twitter"
                id="twitter"
                class="mt-1 focus:ring-emerald-500 focus:border-emerald-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md"
                placeholder="@username"
              />
            </div>

            <div>
              <label
                for="linkedin"
                class="block text-sm font-medium text-gray-700"
              >
                LinkedIn
              </label>
              <input
                type="text"
                name="linkedin"
                id="linkedin"
                class="mt-1 focus:ring-emerald-500 focus:border-emerald-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md"
                placeholder="linkedin.com/in/username"
              />
            </div>

            <!-- Save Button -->
            <div class="flex justify-end">
              <button
                type="submit"
                class="ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500"
              >
                Save profile
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Security Tab -->
      <div id="security" class="tab-content hidden">
        <div class="bg-white shadow rounded-lg p-6">
          <h2 class="text-lg font-medium text-gray-900 mb-6">
            Security Settings
          </h2>

          <form
            class="space-y-6"
            method="POST"
            action="/api/user/change-password"
          >
            <!-- Current Password -->
            <div>
              <label
                for="current-password"
                class="block text-sm font-medium text-gray-700"
              >
                Current password
              </label>
              <input
                type="password"
                name="currentPassword"
                id="current-password"
                class="mt-1 focus:ring-emerald-500 focus:border-emerald-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md"
              />
            </div>

            <!-- New Password -->
            <div>
              <label
                for="new-password"
                class="block text-sm font-medium text-gray-700"
              >
                New password
              </label>
              <input
                type="password"
                name="newPassword"
                id="new-password"
                class="mt-1 focus:ring-emerald-500 focus:border-emerald-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md"
              />
            </div>

            <!-- Confirm Password -->
            <div>
              <label
                for="confirm-password"
                class="block text-sm font-medium text-gray-700"
              >
                Confirm new password
              </label>
              <input
                type="password"
                name="confirmPassword"
                id="confirm-password"
                class="mt-1 focus:ring-emerald-500 focus:border-emerald-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md"
              />
            </div>

            <!-- Save Button -->
            <div class="flex justify-end">
              <button
                type="submit"
                class="ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500"
              >
                Update password
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Preferences Tab -->
      <div id="preferences" class="tab-content hidden">
        <div class="bg-white shadow rounded-lg p-6">
          <h2 class="text-lg font-medium text-gray-900 mb-6">
            Email Preferences
          </h2>

          <form
            class="space-y-6"
            method="POST"
            action="/api/user/update-preferences"
          >
            <!-- Email Notifications -->
            <fieldset>
              <legend class="text-base font-medium text-gray-900"
                >Email Notifications</legend
              >
              <div class="mt-4 space-y-4">
                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <input
                      id="comments"
                      name="comments"
                      type="checkbox"
                      class="focus:ring-emerald-500 h-4 w-4 text-emerald-600 border-gray-300 rounded"
                      checked
                    />
                  </div>
                  <div class="ml-3 text-sm">
                    <label for="comments" class="font-medium text-gray-700"
                      >Comments</label
                    >
                    <p class="text-gray-500">
                      Get notified when someone comments on your posts.
                    </p>
                  </div>
                </div>

                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <input
                      id="likes"
                      name="likes"
                      type="checkbox"
                      class="focus:ring-emerald-500 h-4 w-4 text-emerald-600 border-gray-300 rounded"
                    />
                  </div>
                  <div class="ml-3 text-sm">
                    <label for="likes" class="font-medium text-gray-700"
                      >Likes</label
                    >
                    <p class="text-gray-500">
                      Get notified when someone likes your posts.
                    </p>
                  </div>
                </div>

                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <input
                      id="newsletter"
                      name="newsletter"
                      type="checkbox"
                      class="focus:ring-emerald-500 h-4 w-4 text-emerald-600 border-gray-300 rounded"
                      checked
                    />
                  </div>
                  <div class="ml-3 text-sm">
                    <label for="newsletter" class="font-medium text-gray-700"
                      >Newsletter</label
                    >
                    <p class="text-gray-500">
                      Receive our weekly newsletter with health insights.
                    </p>
                  </div>
                </div>
              </div>
            </fieldset>

            <!-- Save Button -->
            <div class="flex justify-end">
              <button
                type="submit"
                class="ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500"
              >
                Save preferences
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Tab switching
    const tabs = document.querySelectorAll('.tab-link');
    const contents = document.querySelectorAll('.tab-content');

    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const target = tab.getAttribute('href')?.substring(1);

        // Update tab styles
        tabs.forEach((t) => {
          t.classList.remove('border-emerald-500', 'text-emerald-600');
          t.classList.add('border-transparent', 'text-gray-500');
        });
        tab.classList.remove('border-transparent', 'text-gray-500');
        tab.classList.add('border-emerald-500', 'text-emerald-600');

        // Show/hide content
        contents.forEach((content) => {
          if (content.id === target) {
            content.classList.remove('hidden');
          } else {
            content.classList.add('hidden');
          }
        });
      });
    });
  </script>
</Layout>
