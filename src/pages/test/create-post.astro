---
/**
 * Test Post Creation - Diagnostic Page
 * Use this page to test post creation API in production
 */

import Layout from '../../layouts/Layout.astro';
import { getCurrentSession } from '../../lib/session';

const user = await getCurrentSession(Astro.cookies);

if (!user) {
  return Astro.redirect('/login?redirect=/test/create-post');
}
---

<Layout title="Test Post Creation - Diagnostic">
  <div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4">
      <div class="bg-white rounded-lg shadow-md p-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-6">
          Post Creation Diagnostic Tool
        </h1>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
          <h2 class="font-semibold text-blue-900 mb-2">Current User</h2>
          <p class="text-sm text-blue-800">Email: {user.email}</p>
          <p class="text-sm text-blue-800">Role: {user.role}</p>
          <p class="text-sm text-blue-800">ID: {user.id}</p>
        </div>

        <!-- Simple Test Form -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold mb-4">Quick Test</h2>
          <form id="quick-test-form" class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                Title
              </label>
              <input
                type="text"
                id="test-title"
                value="Test Post"
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                Content
              </label>
              <textarea
                id="test-content"
                rows="4"
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                >This is a test post created from the diagnostic tool.</textarea
              >
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">
                Status
              </label>
              <select
                id="test-status"
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              >
                <option value="draft">Draft</option>
                <option value="published">Published</option>
              </select>
            </div>

            <button
              type="submit"
              class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              Test Create Post
            </button>
          </form>
        </div>

        <!-- Console Output -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold mb-4">Console Output</h2>
          <div
            id="console-output"
            class="bg-gray-900 text-green-400 p-4 rounded-md font-mono text-sm overflow-auto max-h-96"
          >
          </div>
        </div>

        <!-- Run Diagnostics Button -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold mb-4">Full Diagnostics</h2>
          <button
            id="run-diagnostics"
            class="px-4 py-2 bg-purple-600 text-white rounded-md hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-500"
          >
            Run Full Diagnostic Suite
          </button>
        </div>

        <!-- Instructions -->
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
          <h3 class="font-semibold mb-2">Instructions</h3>
          <ol class="list-decimal list-inside space-y-1 text-sm text-gray-700">
            <li>Fill in the test form above (or use defaults)</li>
            <li>Click "Test Create Post" to attempt creation</li>
            <li>Check the console output for detailed logs</li>
            <li>If the test fails, click "Run Full Diagnostic Suite"</li>
            <li>Copy the diagnostic output and report the issue</li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Console output logger
    const consoleOutput = document.getElementById('console-output');

    function log(message, type = 'info') {
      const colors = {
        info: 'text-green-400',
        error: 'text-red-400',
        warn: 'text-yellow-400',
        success: 'text-cyan-400',
      };

      const timestamp = new Date().toLocaleTimeString();
      const line = document.createElement('div');
      line.className = colors[type] || colors.info;
      line.textContent = `[${timestamp}] ${message}`;
      consoleOutput.appendChild(line);
      consoleOutput.scrollTop = consoleOutput.scrollHeight;

      // Also log to browser console
      console.log(message);
    }

    // Quick test form
    const quickTestForm = document.getElementById('quick-test-form');
    quickTestForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      consoleOutput.innerHTML = '';
      log('=== Starting Post Creation Test ===', 'info');

      const title = (document.getElementById('test-title') as HTMLInputElement)
        .value;
      const content = (
        document.getElementById('test-content') as HTMLTextAreaElement
      ).value;
      const status = (
        document.getElementById('test-status') as HTMLSelectElement
      ).value;

      const postData = {
        title,
        content,
        status,
      };

      log('Test data: ' + JSON.stringify(postData, null, 2), 'info');

      try {
        const csrfToken = (
          document.querySelector('input[name="csrf_token"]') as HTMLInputElement
        )?.value;

        if (!csrfToken) {
          log('ERROR: No CSRF token found!', 'error');
          return;
        }

        log('CSRF token: ' + csrfToken.substring(0, 20) + '...', 'info');
        log('Sending POST request to /api/posts...', 'info');

        const response = await fetch('/api/posts', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
          },
          credentials: 'include',
          body: JSON.stringify(postData),
        });

        log(
          'Response status: ' + response.status,
          response.ok ? 'success' : 'error',
        );

        const result = await response.json();
        log(
          'Response data: ' + JSON.stringify(result, null, 2),
          response.ok ? 'success' : 'error',
        );

        if (response.ok && result.success) {
          log('✓ SUCCESS: Post created!', 'success');
          log('Post ID: ' + result.post?.id, 'success');
          log('Post slug: ' + result.post?.slug, 'success');

          // Add link to view/edit
          if (result.post?.id) {
            const editUrl = `/dashboard/edit-post/${result.post.id}`;
            log(`Edit post: ${editUrl}`, 'success');
          }
        } else {
          log('✗ FAILED: Post creation failed', 'error');
          log('Error: ' + (result.error || 'Unknown error'), 'error');

          if (result.details) {
            log('Details: ' + result.details, 'error');
          }

          if (result.debugInfo) {
            log('Debug info: ' + result.debugInfo, 'error');
          }
        }
      } catch (error: any) {
        log('✗ EXCEPTION: ' + error.message, 'error');
        log('Stack trace: ' + error.stack, 'error');
      }

      log('=== Test Complete ===', 'info');
    });

    // Run diagnostics button
    const runDiagnosticsBtn = document.getElementById('run-diagnostics');
    runDiagnosticsBtn?.addEventListener('click', async () => {
      consoleOutput.innerHTML = '';
      log('=== Running Full Diagnostic Suite ===', 'info');

      // 1. Check authentication
      log('\n1. Checking authentication...', 'info');
      try {
        const authResponse = await fetch('/api/auth/session', {
          credentials: 'include',
        });
        const session = await authResponse.json();

        if (session && session.user) {
          log('✓ User authenticated', 'success');
          log('  Email: ' + session.user.email, 'info');
          log('  Role: ' + session.user.role, 'info');
          log('  ID: ' + session.user.id, 'info');

          if (session.user.role !== 'admin' && session.user.role !== 'author') {
            log('⚠ WARNING: User role is not admin or author!', 'warn');
          }
        } else {
          log('✗ Not authenticated', 'error');
        }
      } catch (error: any) {
        log('✗ Auth check failed: ' + error.message, 'error');
      }

      // 2. Check CSRF token
      log('\n2. Checking CSRF token...', 'info');
      const csrfInput = document.querySelector(
        'input[name="csrf_token"]',
      ) as HTMLInputElement;
      if (csrfInput && csrfInput.value) {
        log(
          '✓ CSRF token found: ' + csrfInput.value.substring(0, 20) + '...',
          'success',
        );
      } else {
        log('✗ CSRF token not found!', 'error');
      }

      // 3. Check PocketBase connection
      log('\n3. Checking PocketBase connection...', 'info');
      try {
        const healthResponse = await fetch('/api/health', {
          credentials: 'include',
        });
        if (healthResponse.ok) {
          const health = await healthResponse.json();
          log('✓ PocketBase connection OK', 'success');
          log('  Health data: ' + JSON.stringify(health), 'info');
        } else {
          log(
            '✗ PocketBase health check failed: ' + healthResponse.status,
            'error',
          );
        }
      } catch (error: any) {
        log('✗ PocketBase connection error: ' + error.message, 'error');
      }

      // 4. Test minimal post creation
      log('\n4. Testing minimal post creation...', 'info');
      try {
        const minimalPost = {
          title: 'Diagnostic Test ' + new Date().toISOString(),
          content: '<p>Minimal test post</p>',
          status: 'draft',
        };

        log('Creating post: ' + JSON.stringify(minimalPost, null, 2), 'info');

        const response = await fetch('/api/posts', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfInput?.value || '',
          },
          credentials: 'include',
          body: JSON.stringify(minimalPost),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          log('✓ Minimal post creation successful!', 'success');
          log('  Post ID: ' + result.post?.id, 'success');
        } else {
          log('✗ Minimal post creation failed', 'error');
          log('  Status: ' + response.status, 'error');
          log('  Error: ' + result.error, 'error');
          if (result.details) {
            log('  Details: ' + result.details, 'error');
          }
        }
      } catch (error: any) {
        log('✗ Test failed: ' + error.message, 'error');
      }

      log('\n=== Diagnostic Suite Complete ===', 'info');
      log(
        '\nPlease copy this output and include it in your bug report.',
        'warn',
      );
    });

    log(
      'Diagnostic tool ready. Fill out the form and click "Test Create Post".',
      'success',
    );
  </script>

  <!-- Hidden CSRF token -->
  <input
    type="hidden"
    name="csrf_token"
    value={Astro.cookies.get('csrf_token')?.value || ''}
  />
</Layout>
