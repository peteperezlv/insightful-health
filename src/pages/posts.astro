---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { listPosts, getCategories } from '../lib/posts';
import { getPocketBase } from '../lib/pocketbase';

// Get query parameters for filtering
const url = Astro.url;
const selectedCategory = url.searchParams.get('category') || '';
const selectedTags = url.searchParams.getAll('tag');
const currentPage = parseInt(url.searchParams.get('page') || '1');
const perPage = 20;

// Fetch categories for the filter sidebar
let categories: { id: string; name: string; slug: string }[] = [];
try {
  categories = await getCategories();
} catch (error) {
  console.error('Failed to load categories:', error);
}

// Fetch all unique tags from posts
const pb = getPocketBase();
let allTags: string[] = [];
try {
  const allPosts = await pb.collection('posts').getFullList({
    filter: 'status = "published"',
    fields: 'tags',
  });
  const tagsSet = new Set<string>();
  allPosts.forEach((post: any) => {
    if (post.tags && Array.isArray(post.tags)) {
      post.tags.forEach((tag: string) => tagsSet.add(tag));
    }
  });
  allTags = Array.from(tagsSet).sort();
} catch (error) {
  console.error('Failed to load tags:', error);
}

// Fetch posts with filters
let posts: any[] = [];
let totalPages = 1;
let totalItems = 0;

try {
  // Build filter options
  const filterOptions: any = {
    page: currentPage,
    perPage,
    status: 'published',
    sort: '-created',
  };

  // Add category filter if selected
  if (selectedCategory) {
    const category = categories.find(c => c.slug === selectedCategory);
    if (category) {
      filterOptions.categoryId = category.id;
    }
  }

  const result = await listPosts(filterOptions);
  
  if (result.success) {
    posts = result.posts || [];
    totalPages = result.totalPages || 1;
    totalItems = result.totalItems || 0;

    // Client-side filter by tags (since PocketBase doesn't support array filtering easily)
    if (selectedTags.length > 0) {
      posts = posts.filter(post => 
        post.tags && Array.isArray(post.tags) && 
        selectedTags.some(tag => post.tags.includes(tag))
      );
    }
  }
} catch (error) {
  console.error('Failed to load posts:', error);
}

// Build pagination array
const paginationItems: Array<{ type: 'page' | 'ellipsis'; page?: number; active?: boolean }> = [];
if (totalPages > 1) {
  for (let i = 1; i <= totalPages; i++) {
    const showPage = i === 1 || i === totalPages || Math.abs(i - currentPage) <= 1;
    
    if (showPage) {
      paginationItems.push({ type: 'page', page: i, active: i === currentPage });
    } else if (i === currentPage - 2 || i === currentPage + 2) {
      // Add ellipsis only once on each side
      if (paginationItems[paginationItems.length - 1]?.type !== 'ellipsis') {
        paginationItems.push({ type: 'ellipsis' });
      }
    }
  }
}
---

<Layout title="All Posts" description="Browse all health insights articles">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="mb-4">All Posts</h1>
    <p class="text-gray-600 mb-2">
      Browse our collection of health insights and data analytics articles.
    </p>
    {totalItems > 0 && (
      <p class="text-sm text-gray-500 mb-8">
        Showing {posts.length} of {totalItems} posts
        {selectedCategory && ` in ${categories.find(c => c.slug === selectedCategory)?.name}`}
        {selectedTags.length > 0 && ` tagged with ${selectedTags.join(', ')}`}
      </p>
    )}

    <!-- Sidebar with filters -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Filters Sidebar -->
      <aside class="lg:col-span-1">
        <div class="sticky top-20">
          <div class="mb-6">
            <label for="category-filter" class="block text-lg font-semibold mb-3">
              Categories
            </label>
            <select 
              id="category-filter"
              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
              onchange="window.location.href = this.value"
            >
              <option value="/posts" selected={!selectedCategory}>
                All Categories
              </option>
              {categories.map((category) => (
                <option 
                  value={`/posts?category=${category.slug}`}
                  selected={selectedCategory === category.slug}
                >
                  {category.name}
                </option>
              ))}
            </select>
          </div>

          {allTags.length > 0 && (
            <div class="mb-6">
              <h3 class="text-lg font-semibold mb-4">Tags</h3>
              <div class="flex flex-wrap gap-2">
                {allTags.slice(0, 15).map((tag) => {
                  const isSelected = selectedTags.includes(tag);
                  const newUrl = new URL(Astro.url);
                  
                  if (isSelected) {
                    // Remove this tag
                    const tags = newUrl.searchParams.getAll('tag').filter(t => t !== tag);
                    newUrl.searchParams.delete('tag');
                    tags.forEach(t => newUrl.searchParams.append('tag', t));
                  } else {
                    // Add this tag
                    newUrl.searchParams.append('tag', tag);
                  }
                  
                  return (
                    <a
                      href={newUrl.pathname + newUrl.search}
                      class={`px-3 py-1 rounded-full text-sm transition-colors ${
                        isSelected 
                          ? 'bg-emerald-600 text-white hover:bg-emerald-700' 
                          : 'bg-emerald-100 text-emerald-700 hover:bg-emerald-200'
                      }`}
                    >
                      {tag}
                    </a>
                  );
                })}
              </div>
            </div>
          )}

          {(selectedCategory || selectedTags.length > 0) && (
            <div class="mt-4">
              <a 
                href="/posts" 
                class="text-sm text-emerald-600 hover:text-emerald-700 font-medium"
              >
                ← Clear all filters
              </a>
            </div>
          )}
        </div>
      </aside>

      <!-- Posts Grid -->
      <section class="lg:col-span-3">
        {
          posts.length === 0 ? (
            <div class="text-center py-12">
              <p class="text-gray-500 text-lg">
                No published posts yet. Check back soon!
              </p>
            </div>
          ) : (
            <div class="space-y-6">
              {posts.map((post) => (
                <article class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
                  <div class="flex justify-between items-start gap-4 mb-3">
                    <h3>
                      <a
                        href={`/post/${post.slug}`}
                        class="hover:text-emerald-600"
                      >
                        {post.title}
                      </a>
                    </h3>
                    <span class="text-sm text-gray-500">
                      {new Date(
                        post.publishedAt || post.created
                      ).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric',
                      })}
                    </span>
                  </div>
                  {post.excerpt && (
                    <p class="text-gray-600 mb-4">{post.excerpt}</p>
                  )}
                  {post.tags && Array.isArray(post.tags) && post.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-4">
                      {post.tags.map((tag: string) => (
                        <span class="px-2 py-1 bg-gray-100 text-gray-700 text-xs rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                  <div class="flex justify-between items-center text-sm text-gray-500">
                    <span>By {post.authorName || 'Anonymous'}</span>
                    <a
                      href={`/post/${post.slug}`}
                      class="text-emerald-600 font-medium hover:text-emerald-700"
                    >
                      Read →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          )
        }
      </section>

      <!-- Pagination -->
      {totalPages > 1 && (
        <nav class="lg:col-span-4 mt-12 flex justify-center gap-2" aria-label="Pagination">
          {currentPage > 1 && (
            <a
              href={`/posts?${new URLSearchParams({ ...Object.fromEntries(url.searchParams), page: String(currentPage - 1) }).toString()}`}
              class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-50"
            >
              Previous
            </a>
          )}
          
          {paginationItems.map((item, index) => {
            if (item.type === 'ellipsis') {
              return (
                <span key={`ellipsis-${index}`} class="px-4 py-2 text-gray-400">
                  ...
                </span>
              );
            }
            
            const pageUrl = new URL(url);
            pageUrl.searchParams.set('page', String(item.page));
            
            return (
              <a
                key={`page-${item.page}`}
                href={pageUrl.pathname + pageUrl.search}
                class={`px-4 py-2 border rounded ${
                  item.active
                    ? 'border-emerald-600 bg-emerald-50 text-emerald-600 font-medium'
                    : 'border-gray-300 hover:bg-gray-50'
                }`}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.page}
              </a>
            );
          })}
          
          {currentPage < totalPages && (
            <a
              href={`/posts?${new URLSearchParams({ ...Object.fromEntries(url.searchParams), page: String(currentPage + 1) }).toString()}`}
              class="px-4 py-2 border border-gray-300 rounded hover:bg-gray-50"
            >
              Next
            </a>
          )}
        </nav>
      )}
    </div>
  </div>
</Layout>
