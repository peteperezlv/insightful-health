---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { author: 'john-doe' } },
    { params: { author: 'jane-smith' } },
    { params: { author: 'bob-johnson' } },
  ];
}

const { author } = Astro.params;
---

<Layout title={`Author: ${author}`} description={`Articles by ${author}`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Author Info -->
    <div class="mb-12 bg-emerald-50 rounded-lg p-8">
      <div class="flex items-start gap-6 mb-6">
        <div
          class="w-24 h-24 bg-emerald-600 rounded-full flex items-center justify-center text-white text-4xl font-bold"
        >
          JD
        </div>
        <div class="flex-1">
          <h1 class="mb-2">John Doe</h1>
          <p class="text-gray-600 mb-4">
            Public health researcher and data analyst with a passion for sharing
            insights about health trends and community wellness.
          </p>
          <div class="flex gap-4">
            <a href="#" class="text-emerald-600 hover:text-emerald-700"
              >Twitter →</a
            >
            <a href="#" class="text-emerald-600 hover:text-emerald-700"
              >LinkedIn →</a
            >
            <a
              href="mailto:john@example.com"
              class="text-emerald-600 hover:text-emerald-700">Contact →</a
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Author Posts -->
    <section>
      <h2 class="mb-8">Posts by John Doe</h2>
      <div class="space-y-6">
        {
          [1, 2, 3, 4].map((i) => (
            <article class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
              <h3 class="mb-2">
                <a href="/post/1" class="hover:text-emerald-600">
                  Article Title {i}
                </a>
              </h3>
              <p class="text-gray-600 mb-4">
                Brief excerpt from the health insights article published by this
                author.
              </p>
              <div class="flex justify-between items-center text-sm text-gray-500">
                <span>Dec {i}, 2025 • 6 min read</span>
                <a
                  href="/post/1"
                  class="text-emerald-600 font-medium hover:text-emerald-700"
                >
                  Read →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
