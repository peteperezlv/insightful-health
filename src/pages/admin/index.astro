---
/**
 * Admin Dashboard
 * Protected page - requires admin role
 */

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { isAdmin } from '../../lib/session';
import { getPocketBase } from '../../lib/pocketbase';
import { getRecentAuditLogs, formatAuditAction, formatResourceType } from '../../lib/auditLog';

const user = Astro.locals.user;

// Double-check admin access (middleware should handle this, but defense in depth)
if (!user || !isAdmin(user)) {
  return Astro.redirect('/403');
}

// Fetch dashboard stats
const pb = getPocketBase();

// Get total counts
const [totalUsers, totalPosts, pendingComments] = await Promise.all([
  pb.collection('users').getList(1, 1, { fields: 'id' }),
  pb.collection('posts').getList(1, 1, { 
    filter: 'status = "published"',
    fields: 'id' 
  }),
  pb.collection('comments').getList(1, 1, { 
    filter: 'status = "pending"',
    fields: 'id' 
  })
]);

// Get views today (analytics events from last 24 hours)
const today = new Date();
today.setHours(0, 0, 0, 0);
const todayStr = today.toISOString().replace('T', ' ');

let viewsToday = 0;
try {
  const analyticsToday = await pb.collection('analytics').getList(1, 1, {
    filter: `eventType = "view" && created >= "${todayStr}"`,
    fields: 'id'
  });
  viewsToday = analyticsToday.totalItems;
} catch (error) {
  console.error('Error fetching views today:', error);
}

// Get recent audit logs (last 10 actions)
const recentAuditLogs = await getRecentAuditLogs(10, 1);

// Format date for display
const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  const now = new Date();
  const diffInMinutes = Math.floor((now.getTime() - date.getTime()) / (1000 * 60));
  
  if (diffInMinutes < 1) return 'Just now';
  if (diffInMinutes < 60) return `${diffInMinutes} minutes ago`;
  if (diffInMinutes < 1440) return `${Math.floor(diffInMinutes / 60)} hours ago`;
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};
---

<Layout title="Admin Dashboard - Insightful Health">
  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Admin Dashboard</h1>
      <p class="mt-2 text-sm text-gray-600">
        Manage users, posts, comments, and platform settings.
      </p>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-emerald-100 text-emerald-600">
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">Total Users</p>
            <p class="text-2xl font-semibold text-gray-900" id="total-users">
              {totalUsers.totalItems.toLocaleString()}
            </p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-blue-100 text-blue-600">
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">Total Posts</p>
            <p class="text-2xl font-semibold text-gray-900" id="total-posts">
              {totalPosts.totalItems.toLocaleString()}
            </p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-yellow-100 text-yellow-600">
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
              ></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">Pending Comments</p>
            <p
              class="text-2xl font-semibold text-gray-900"
              id="pending-comments"
            >
              {pendingComments.totalItems.toLocaleString()}
            </p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-purple-100 text-purple-600">
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500">Views Today</p>
            <p class="text-2xl font-semibold text-gray-900" id="views-today">
              {viewsToday.toLocaleString()}
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Navigation -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Users -->
      <a
        href="/admin/users"
        class="block bg-white rounded-lg shadow p-6 hover:shadow-md transition-shadow"
      >
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-emerald-100 text-emerald-600">
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
              ></path>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-medium text-gray-900">User Management</h3>
            <p class="text-sm text-gray-500">
              View, edit, and manage user accounts
            </p>
          </div>
        </div>
      </a>

      <!-- Posts -->
      <a
        href="/admin/posts"
        class="block bg-white rounded-lg shadow p-6 hover:shadow-md transition-shadow"
      >
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-blue-100 text-blue-600">
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-medium text-gray-900">Post Management</h3>
            <p class="text-sm text-gray-500">Manage and moderate blog posts</p>
          </div>
        </div>
      </a>

      <!-- Comments -->
      <a
        href="/admin/comments"
        class="block bg-white rounded-lg shadow p-6 hover:shadow-md transition-shadow"
      >
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-yellow-100 text-yellow-600">
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
              ></path>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-medium text-gray-900">
              Comment Moderation
            </h3>
            <p class="text-sm text-gray-500">Review and moderate comments</p>
          </div>
        </div>
      </a>

      <!-- Analytics -->
      <a
        href="/admin/analytics"
        class="block bg-white rounded-lg shadow p-6 hover:shadow-md transition-shadow"
      >
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-purple-100 text-purple-600">
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              ></path>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-medium text-gray-900">Analytics</h3>
            <p class="text-sm text-gray-500">
              View platform statistics and insights
            </p>
          </div>
        </div>
      </a>

      <!-- Settings -->
      <a
        href="/admin/settings"
        class="block bg-white rounded-lg shadow p-6 hover:shadow-md transition-shadow"
      >
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-gray-100 text-gray-600">
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-medium text-gray-900">Settings</h3>
            <p class="text-sm text-gray-500">Configure platform settings</p>
          </div>
        </div>
      </a>

      <!-- Audit Log -->
      <a
        href="/admin/audit-log"
        class="block bg-white rounded-lg shadow p-6 hover:shadow-md transition-shadow"
      >
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-red-100 text-red-600">
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
              ></path>
            </svg>
          </div>
          <div class="ml-4">
            <h3 class="text-lg font-medium text-gray-900">Audit Log</h3>
            <p class="text-sm text-gray-500">View admin activity history</p>
          </div>
        </div>
      </a>
    </div>

    <!-- Recent Activity -->
    <div class="mt-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold text-gray-900">Recent Admin Activity</h2>
        <a href="/admin/audit-log" class="text-sm text-emerald-600 hover:text-emerald-700 font-medium">
          View All →
        </a>
      </div>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        {recentAuditLogs.items.length === 0 ? (
          <div class="p-6 text-center text-gray-500">
            <svg
              class="mx-auto h-12 w-12 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p class="mt-2">No recent activity</p>
          </div>
        ) : (
          <ul class="divide-y divide-gray-200">
            {recentAuditLogs.items.map((log: any) => (
              <li class="p-4 hover:bg-gray-50 transition-colors">
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <div class="flex items-center gap-2">
                      <span class="font-medium text-gray-900">
                        {log.expand?.userId?.username || 'Unknown Admin'}
                      </span>
                      <span class="text-gray-500">•</span>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                        {formatAuditAction(log.action)}
                      </span>
                      <span class="text-gray-500">•</span>
                      <span class="text-sm text-gray-600">
                        {formatResourceType(log.resourceType)}
                      </span>
                    </div>
                    <p class="mt-1 text-sm text-gray-600">
                      {log.metadata?.targetUsername && (
                        <span>User: <strong>{log.metadata.targetUsername}</strong></span>
                      )}
                      {!log.metadata?.targetUsername && (
                        <span>Resource ID: <code class="text-xs bg-gray-100 px-1 py-0.5 rounded">{log.resourceId.substring(0, 12)}...</code></span>
                      )}
                    </p>
                  </div>
                  <div class="text-right ml-4">
                    <p class="text-xs text-gray-500">{formatDate(log.created)}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</Layout>
