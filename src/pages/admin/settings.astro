---
/**
 * Admin Settings
 * Configure site-wide settings
 */

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { isAdmin } from '../../lib/session';
import { getPocketBase } from '../../lib/pocketbase';

const user = Astro.locals.user;

// Double-check admin access
if (!user || !isAdmin(user)) {
  return Astro.redirect('/403');
}

// Fetch current settings from environment or database
const pb = getPocketBase();

// Try to fetch settings from a settings collection (if it exists)
let settings: any = {
  siteName: 'Insightful Health',
  siteDescription: 'Insights on public health data analytics',
  siteUrl: import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321',
  contactEmail: '',
  socialTwitter: '',
  socialLinkedIn: '',
  socialGitHub: '',
  socialFacebook: '',
  enableComments: true,
  enableNewsletter: false,
  moderateComments: true,
  analyticsEnabled: !!import.meta.env.PUBLIC_GA_ID,
  analyticsId: import.meta.env.PUBLIC_GA_ID || '',
};

// Note: In a real implementation, you might want to store these in a PocketBase collection
// For now, we'll use environment variables and allow runtime configuration
---

<Layout title="Settings - Admin">
  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <a
        href="/admin"
        class="text-sm text-emerald-600 hover:text-emerald-700 mb-2 inline-block"
      >
        ← Back to Admin Dashboard
      </a>
      <h1 class="text-3xl font-bold text-gray-900">Settings</h1>
      <p class="mt-2 text-sm text-gray-600">
        Configure site-wide settings and preferences.
      </p>
    </div>

    <!-- Success/Error Messages -->
    <div id="alert-container" class="mb-6 hidden">
      <div id="alert-message" class="p-4 rounded-md"></div>
    </div>

    <!-- Tabs -->
    <div class="mb-6 border-b border-gray-200">
      <nav class="-mb-px flex space-x-8">
        <button
          class="tab-button border-b-2 border-emerald-500 py-4 px-1 text-sm font-medium text-emerald-600"
          data-tab="general"
        >
          General
        </button>
        <button
          class="tab-button border-b-2 border-transparent py-4 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300"
          data-tab="social"
        >
          Social Media
        </button>
        <button
          class="tab-button border-b-2 border-transparent py-4 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300"
          data-tab="features"
        >
          Features
        </button>
        <button
          class="tab-button border-b-2 border-transparent py-4 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300"
          data-tab="analytics"
        >
          Analytics
        </button>
      </nav>
    </div>

    <!-- Settings Form -->
    <form id="settings-form" class="space-y-8">
      <!-- General Settings Tab -->
      <div id="tab-general" class="tab-content">
        <div class="bg-white shadow rounded-lg p-6 space-y-6">
          <h2 class="text-lg font-medium text-gray-900">General Settings</h2>

          <div>
            <label
              for="site-name"
              class="block text-sm font-medium text-gray-700"
            >
              Site Name
            </label>
            <input
              type="text"
              id="site-name"
              name="site-name"
              value={settings.siteName}
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
            />
            <p class="mt-1 text-xs text-gray-500">
              The name of your site (appears in header and meta tags)
            </p>
          </div>

          <div>
            <label
              for="site-description"
              class="block text-sm font-medium text-gray-700"
            >
              Site Description
            </label>
            <textarea
              id="site-description"
              name="site-description"
              rows="3"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
              >{settings.siteDescription}</textarea
            >
            <p class="mt-1 text-xs text-gray-500">
              Brief description for SEO and social sharing
            </p>
          </div>

          <div>
            <label
              for="site-url"
              class="block text-sm font-medium text-gray-700"
            >
              Site URL
            </label>
            <input
              type="url"
              id="site-url"
              name="site-url"
              value={settings.siteUrl}
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
              placeholder="https://example.com"
            />
            <p class="mt-1 text-xs text-gray-500">
              Your production site URL (used for canonical URLs)
            </p>
          </div>

          <div>
            <label
              for="contact-email"
              class="block text-sm font-medium text-gray-700"
            >
              Contact Email
            </label>
            <input
              type="email"
              id="contact-email"
              name="contact-email"
              value={settings.contactEmail}
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
              placeholder="contact@example.com"
            />
            <p class="mt-1 text-xs text-gray-500">
              Public contact email for your site
            </p>
          </div>
        </div>
      </div>

      <!-- Social Media Tab -->
      <div id="tab-social" class="tab-content hidden">
        <div class="bg-white shadow rounded-lg p-6 space-y-6">
          <h2 class="text-lg font-medium text-gray-900">Social Media Links</h2>
          <p class="text-sm text-gray-500">
            Add your social media profiles (leave blank to hide)
          </p>

          <div>
            <label
              for="social-twitter"
              class="block text-sm font-medium text-gray-700"
            >
              Twitter/X
            </label>
            <input
              type="text"
              id="social-twitter"
              name="social-twitter"
              value={settings.socialTwitter}
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
              placeholder="@insightfulhealth"
            />
          </div>

          <div>
            <label
              for="social-linkedin"
              class="block text-sm font-medium text-gray-700"
            >
              LinkedIn
            </label>
            <input
              type="url"
              id="social-linkedin"
              name="social-linkedin"
              value={settings.socialLinkedIn}
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
              placeholder="https://linkedin.com/company/insightful-health"
            />
          </div>

          <div>
            <label
              for="social-github"
              class="block text-sm font-medium text-gray-700"
            >
              GitHub
            </label>
            <input
              type="url"
              id="social-github"
              name="social-github"
              value={settings.socialGitHub}
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
              placeholder="https://github.com/insightful-health"
            />
          </div>

          <div>
            <label
              for="social-facebook"
              class="block text-sm font-medium text-gray-700"
            >
              Facebook
            </label>
            <input
              type="url"
              id="social-facebook"
              name="social-facebook"
              value={settings.socialFacebook}
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
              placeholder="https://facebook.com/insightfulhealth"
            />
          </div>
        </div>
      </div>

      <!-- Features Tab -->
      <div id="tab-features" class="tab-content hidden">
        <div class="bg-white shadow rounded-lg p-6 space-y-6">
          <h2 class="text-lg font-medium text-gray-900">Feature Settings</h2>

          <div class="flex items-start">
            <div class="flex items-center h-5">
              <input
                id="enable-comments"
                name="enable-comments"
                type="checkbox"
                checked={settings.enableComments}
                class="h-4 w-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500"
              />
            </div>
            <div class="ml-3">
              <label
                for="enable-comments"
                class="text-sm font-medium text-gray-700"
              >
                Enable Comments
              </label>
              <p class="text-xs text-gray-500">
                Allow users to comment on posts
              </p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex items-center h-5">
              <input
                id="moderate-comments"
                name="moderate-comments"
                type="checkbox"
                checked={settings.moderateComments}
                class="h-4 w-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500"
              />
            </div>
            <div class="ml-3">
              <label
                for="moderate-comments"
                class="text-sm font-medium text-gray-700"
              >
                Moderate Comments
              </label>
              <p class="text-xs text-gray-500">
                Require approval before comments are published
              </p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex items-center h-5">
              <input
                id="enable-newsletter"
                name="enable-newsletter"
                type="checkbox"
                checked={settings.enableNewsletter}
                class="h-4 w-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500"
              />
            </div>
            <div class="ml-3">
              <label
                for="enable-newsletter"
                class="text-sm font-medium text-gray-700"
              >
                Enable Newsletter
              </label>
              <p class="text-xs text-gray-500">Show newsletter signup forms</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Analytics Tab -->
      <div id="tab-analytics" class="tab-content hidden">
        <div class="bg-white shadow rounded-lg p-6 space-y-6">
          <h2 class="text-lg font-medium text-gray-900">Analytics Settings</h2>

          <div class="bg-blue-50 border border-blue-200 rounded-md p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg
                  class="h-5 w-5 text-blue-400"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm text-blue-700">
                  <strong>Note:</strong> Analytics settings are configured via environment
                  variables. Update your <code class="bg-blue-100 px-1 rounded"
                    >.env</code
                  > file to change these settings.
                </p>
              </div>
            </div>
          </div>

          <div>
            <label
              for="analytics-id"
              class="block text-sm font-medium text-gray-700"
            >
              Google Analytics ID
            </label>
            <input
              type="text"
              id="analytics-id"
              name="analytics-id"
              value={settings.analyticsId}
              disabled
              class="mt-1 block w-full rounded-md border-gray-300 bg-gray-50 shadow-sm sm:text-sm"
              placeholder="G-XXXXXXXXXX"
            />
            <p class="mt-1 text-xs text-gray-500">
              Current: {settings.analyticsId || 'Not configured'}
              <br />
              To change: Update <code class="bg-gray-100 px-1 rounded"
                >PUBLIC_GA_ID</code
              > in your <code class="bg-gray-100 px-1 rounded">.env</code> file
            </p>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">
              Internal Analytics
            </label>
            <p class="mt-1 text-xs text-gray-500">
              The platform tracks page views and engagement internally via
              PocketBase. View analytics data in the <a
                href="/admin/analytics"
                class="text-emerald-600 hover:text-emerald-700 underline"
                >Analytics Dashboard</a
              >.
            </p>
          </div>
        </div>
      </div>

      <!-- Save Button -->
      <div class="flex justify-end">
        <button
          type="button"
          id="save-btn"
          class="px-6 py-2 bg-emerald-600 text-white font-medium rounded-md hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500"
        >
          Save Settings
        </button>
      </div>
    </form>

    <!-- Info Box -->
    <div class="mt-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg
            class="h-5 w-5 text-yellow-400"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">
            Configuration Note
          </h3>
          <div class="mt-2 text-sm text-yellow-700">
            <p>
              Some settings (like site name and social links) are currently
              stored in browser local storage for this session. For persistent
              site-wide configuration, consider setting these in your
              environment variables or creating a dedicated settings collection
              in PocketBase.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Tab switching
  const tabButtons = document.querySelectorAll('.tab-button');
  const tabContents = document.querySelectorAll('.tab-content');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const tabName = button.dataset.tab;

      // Update button styles
      tabButtons.forEach((btn) => {
        btn.classList.remove('border-emerald-500', 'text-emerald-600');
        btn.classList.add('border-transparent', 'text-gray-500');
      });
      button.classList.remove('border-transparent', 'text-gray-500');
      button.classList.add('border-emerald-500', 'text-emerald-600');

      // Update content visibility
      tabContents.forEach((content) => {
        content.classList.add('hidden');
      });
      document.getElementById(`tab-${tabName}`)?.classList.remove('hidden');
    });
  });

  // Alert functions
  function showAlert(message: string, type: 'success' | 'error') {
    const container = document.getElementById('alert-container');
    const alertMsg = document.getElementById('alert-message');

    if (!container || !alertMsg) return;

    const bgColor =
      type === 'success'
        ? 'bg-green-50 border-green-200 text-green-700'
        : 'bg-red-50 border-red-200 text-red-700';

    alertMsg.className = `p-4 rounded-md border ${bgColor}`;
    alertMsg.textContent = message;
    container.classList.remove('hidden');

    // Auto-hide after 5 seconds
    setTimeout(() => {
      container.classList.add('hidden');
    }, 5000);
  }

  // Save settings
  const saveBtn = document.getElementById('save-btn');
  const form = document.getElementById('settings-form') as HTMLFormElement;

  saveBtn?.addEventListener('click', () => {
    const formData = new FormData(form);

    // Collect all settings
    const settings = {
      siteName: formData.get('site-name'),
      siteDescription: formData.get('site-description'),
      siteUrl: formData.get('site-url'),
      contactEmail: formData.get('contact-email'),
      socialTwitter: formData.get('social-twitter'),
      socialLinkedIn: formData.get('social-linkedin'),
      socialGitHub: formData.get('social-github'),
      socialFacebook: formData.get('social-facebook'),
      enableComments: formData.get('enable-comments') === 'on',
      moderateComments: formData.get('moderate-comments') === 'on',
      enableNewsletter: formData.get('enable-newsletter') === 'on',
    };

    // Store in localStorage for this session (in a real app, you'd POST to an API)
    localStorage.setItem('siteSettings', JSON.stringify(settings));

    showAlert(
      'Settings saved successfully! Note: For persistent changes, update your environment variables.',
      'success',
    );

    console.log('Settings saved:', settings);
  });
</script>
