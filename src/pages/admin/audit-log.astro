---
/**
 * Admin Audit Log Page
 * View complete history of admin actions
 */

export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';
import { getRecentAuditLogs, formatAuditAction, formatResourceType } from '../../lib/auditLog';

// Get current user from locals
const user = Astro.locals.user;

if (!user || user.role !== 'admin') {
  return Astro.redirect('/403');
}

// Get query parameters
const url = new URL(Astro.request.url);
const page = parseInt(url.searchParams.get('page') || '1');
const actionFilter = url.searchParams.get('action') || '';
const resourceTypeFilter = url.searchParams.get('resourceType') || '';
const userIdFilter = url.searchParams.get('userId') || '';

const itemsPerPage = 100;

// Fetch audit logs
let auditLogs: any[] = [];
let totalPages = 0;
let totalItems = 0;

try {
  const result = await getRecentAuditLogs(itemsPerPage, page);
  auditLogs = result.items;
  totalPages = result.totalPages;
  totalItems = result.totalItems;
} catch (error) {
  console.error('Failed to fetch audit logs:', error);
}

// Format date and time
const formatDateTime = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
};

// Get action badge class
const getActionBadgeClass = (action: string) => {
  if (action.includes('delete') || action === 'ban' || action === 'reject') {
    return 'bg-red-100 text-red-800';
  } else if (action.includes('create') || action === 'approve' || action === 'publish') {
    return 'bg-green-100 text-green-800';
  } else if (action.includes('update') || action === 'unban') {
    return 'bg-blue-100 text-blue-800';
  } else {
    return 'bg-gray-100 text-gray-800';
  }
};
---

<Layout title="Audit Log - Admin">
  <div class="admin-container">
    <!-- Header -->
    <div class="admin-header">
      <div>
        <h1 class="admin-title">Audit Log</h1>
        <p class="admin-subtitle">Complete history of admin actions and changes</p>
      </div>
      <div class="admin-header-actions">
        <a href="/admin" class="btn-secondary">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            />
          </svg>
          Back to Dashboard
        </a>
        <button
          type="button"
          onclick="exportAuditLogs()"
          class="btn-primary"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
          Export CSV
        </button>
      </div>
    </div>

    <!-- Filters -->
    <div class="filters-container">
      <form method="get" action="" class="filters-form">
        <div class="filter-group">
          <label for="action" class="filter-label">Action:</label>
          <select
            name="action"
            id="action"
            class="filter-select"
            onchange="this.form.submit()"
          >
            <option value="">All Actions</option>
            <option value="create" selected={actionFilter === 'create'}>Create</option>
            <option value="update" selected={actionFilter === 'update'}>Update</option>
            <option value="delete" selected={actionFilter === 'delete'}>Delete</option>
            <option value="publish" selected={actionFilter === 'publish'}>Publish</option>
            <option value="unpublish" selected={actionFilter === 'unpublish'}>Unpublish</option>
            <option value="ban" selected={actionFilter === 'ban'}>Ban</option>
            <option value="unban" selected={actionFilter === 'unban'}>Unban</option>
            <option value="approve" selected={actionFilter === 'approve'}>Approve</option>
            <option value="reject" selected={actionFilter === 'reject'}>Reject</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="resourceType" class="filter-label">Resource:</label>
          <select
            name="resourceType"
            id="resourceType"
            class="filter-select"
            onchange="this.form.submit()"
          >
            <option value="">All Resources</option>
            <option value="user" selected={resourceTypeFilter === 'user'}>User</option>
            <option value="post" selected={resourceTypeFilter === 'post'}>Post</option>
            <option value="comment" selected={resourceTypeFilter === 'comment'}>Comment</option>
            <option value="category" selected={resourceTypeFilter === 'category'}>Category</option>
            <option value="tag" selected={resourceTypeFilter === 'tag'}>Tag</option>
          </select>
        </div>

        {(actionFilter || resourceTypeFilter) && (
          <a href="/admin/audit-log" class="clear-filters-button">Clear Filters</a>
        )}
      </form>
    </div>

    <!-- Audit Log Table -->
    <div class="table-container">
      {auditLogs.length === 0 ? (
        <div class="empty-state">
          <svg class="empty-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
          <h3 class="empty-title">No audit logs found</h3>
          <p class="empty-text">Try adjusting your filters</p>
        </div>
      ) : (
        <table class="data-table">
          <thead>
            <tr>
              <th class="table-header">Timestamp</th>
              <th class="table-header">Admin User</th>
              <th class="table-header">Action</th>
              <th class="table-header">Resource</th>
              <th class="table-header">Resource ID</th>
              <th class="table-header">Details</th>
            </tr>
          </thead>
          <tbody>
            {auditLogs.map((log) => (
              <tr class="table-row">
                <td class="table-cell">
                  <div class="timestamp">{formatDateTime(log.created)}</div>
                </td>
                <td class="table-cell">
                  <div class="user-info-compact">
                    {log.expand?.userId ? (
                      <>
                        <div class="user-name">{log.expand.userId.username}</div>
                        <div class="user-email">{log.expand.userId.email}</div>
                      </>
                    ) : (
                      <div class="user-name">Unknown</div>
                    )}
                  </div>
                </td>
                <td class="table-cell">
                  <span class={`badge ${getActionBadgeClass(log.action)}`}>
                    {formatAuditAction(log.action)}
                  </span>
                </td>
                <td class="table-cell">
                  <span class="resource-type">{formatResourceType(log.resourceType)}</span>
                </td>
                <td class="table-cell">
                  <code class="resource-id">{log.resourceId.substring(0, 8)}...</code>
                </td>
                <td class="table-cell">
                  <button
                    type="button"
                    onclick={`toggleDetails('${log.id}')`}
                    class="details-button"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                    View
                  </button>
                  <div id={`details-${log.id}`} class="details-panel hidden">
                    <div class="details-content">
                      <h4 class="details-title">Action Details</h4>
                      {log.changes && Object.keys(log.changes).length > 0 && (
                        <div class="details-section">
                          <h5 class="details-subtitle">Changes:</h5>
                          <pre class="details-code">{JSON.stringify(log.changes, null, 2)}</pre>
                        </div>
                      )}
                      {log.metadata && Object.keys(log.metadata).length > 0 && (
                        <div class="details-section">
                          <h5 class="details-subtitle">Metadata:</h5>
                          <pre class="details-code">{JSON.stringify(log.metadata, null, 2)}</pre>
                        </div>
                      )}
                      <div class="details-section">
                        <h5 class="details-subtitle">Technical Info:</h5>
                        <dl class="details-list">
                          <dt>IP Address:</dt>
                          <dd>{log.ipAddress}</dd>
                          <dt>User Agent:</dt>
                          <dd class="truncate">{log.userAgent}</dd>
                        </dl>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>

    <!-- Pagination -->
    {totalPages > 1 && (
      <Pagination
        currentPage={page}
        totalPages={totalPages}
        totalItems={totalItems}
        itemsPerPage={itemsPerPage}
        baseUrl={Astro.url.pathname}
      />
    )}
  </div>
</Layout>

<style>
  @import "tailwindcss";

  .admin-container {
    @apply min-h-screen bg-gray-50;
  }

  .admin-header {
    @apply bg-white border-b border-gray-200 px-6 py-6 flex items-center justify-between flex-wrap gap-4;
  }

  .admin-title {
    @apply text-2xl font-bold text-gray-900;
  }

  .admin-subtitle {
    @apply mt-1 text-sm text-gray-600;
  }

  .admin-header-actions {
    @apply flex items-center gap-3;
  }

  .btn-secondary {
    @apply inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors;
  }

  .btn-primary {
    @apply inline-flex items-center gap-2 px-4 py-2 bg-emerald-600 border border-transparent rounded-md text-sm font-medium text-white hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors;
  }

  .filters-container {
    @apply bg-white border-b border-gray-200 px-6 py-4;
  }

  .filters-form {
    @apply flex flex-wrap items-center gap-4;
  }

  .filter-group {
    @apply flex items-center gap-2;
  }

  .filter-label {
    @apply text-sm font-medium text-gray-700;
  }

  .filter-select {
    @apply px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent text-sm;
  }

  .clear-filters-button {
    @apply px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors;
  }

  .table-container {
    @apply overflow-x-auto bg-white;
  }

  .data-table {
    @apply min-w-full divide-y divide-gray-200;
  }

  .table-header {
    @apply px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider bg-gray-50;
  }

  .table-row {
    @apply hover:bg-gray-50 transition-colors;
  }

  .table-cell {
    @apply px-6 py-4;
  }

  .timestamp {
    @apply text-sm text-gray-900 font-medium;
  }

  .user-info-compact {
    @apply flex flex-col;
  }

  .user-name {
    @apply text-sm font-medium text-gray-900;
  }

  .user-email {
    @apply text-xs text-gray-500;
  }

  .badge {
    @apply inline-flex px-2 py-1 text-xs font-semibold rounded-full;
  }

  .resource-type {
    @apply text-sm text-gray-700 font-medium;
  }

  .resource-id {
    @apply text-xs font-mono bg-gray-100 px-2 py-1 rounded text-gray-600;
  }

  .details-button {
    @apply inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800 focus:outline-none;
  }

  .details-panel {
    @apply mt-4 p-4 bg-gray-50 rounded-md border border-gray-200;
  }

  .details-content {
    @apply space-y-4;
  }

  .details-title {
    @apply text-sm font-semibold text-gray-900;
  }

  .details-section {
    @apply space-y-2;
  }

  .details-subtitle {
    @apply text-xs font-medium text-gray-700 uppercase;
  }

  .details-code {
    @apply text-xs font-mono bg-white p-3 rounded border border-gray-300 overflow-x-auto;
  }

  .details-list {
    @apply grid grid-cols-2 gap-2 text-sm;
  }

  .details-list dt {
    @apply font-medium text-gray-700;
  }

  .details-list dd {
    @apply text-gray-600;
  }

  .empty-state {
    @apply flex flex-col items-center justify-center py-12 px-4;
  }

  .empty-icon {
    @apply w-16 h-16 text-gray-400 mb-4;
  }

  .empty-title {
    @apply text-lg font-medium text-gray-900 mb-2;
  }

  .empty-text {
    @apply text-sm text-gray-500;
  }
</style>

<script>
  // Toggle details panel
  function toggleDetails(logId: string) {
    const panel = document.getElementById(`details-${logId}`);
    if (panel) {
      panel.classList.toggle('hidden');
    }
  }

  // Export audit logs to CSV
  async function exportAuditLogs() {
    try {
      const response = await fetch('/api/admin/audit-log/export');
      if (response.ok) {
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `audit-log-${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
      } else {
        alert('Failed to export audit logs');
      }
    } catch (error) {
      console.error('Error exporting audit logs:', error);
      alert('An error occurred while exporting');
    }
  }

  // Export functions to window
  (window as any).toggleDetails = toggleDetails;
  (window as any).exportAuditLogs = exportAuditLogs;
</script>
