<script is:inline>
  // Handle featured image functionality
  document.addEventListener('DOMContentLoaded', () => {
    const fileInput = document.getElementById('featured-image-file');
    const imageUrlInput = document.getElementById('image-url-input');
    const featuredImageUrlHidden = document.getElementById('featuredImageUrl');
    const previewImg = document.getElementById('preview-img');
    const previewContainer = document.getElementById('image-preview-container');
    const uploadPlaceholder = document.getElementById('upload-placeholder');
    const uploadProgress = document.getElementById('upload-progress');
    const imageError = document.getElementById('image-error');
    const removeBtn = document.getElementById('remove-image-btn');

    // Handle file selection
    if (fileInput) {
      fileInput.addEventListener('change', async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;

        // Validate file type
        const allowedTypes = [
          'image/jpeg',
          'image/jpg',
          'image/png',
          'image/gif',
          'image/webp',
        ];
        if (!allowedTypes.includes(file.type)) {
          imageError.textContent =
            'Invalid file type. Only JPEG, PNG, GIF, and WebP are allowed.';
          imageError.classList.remove('hidden');
          return;
        }

        // Validate file size (5MB)
        if (file.size > 5 * 1024 * 1024) {
          imageError.textContent = 'File too large. Maximum size is 5MB.';
          imageError.classList.remove('hidden');
          return;
        }

        imageError.classList.add('hidden');

        // Show upload progress
        uploadPlaceholder.classList.add('hidden');
        uploadProgress.classList.remove('hidden');

        try {
          // Upload the file
          const formData = new FormData();
          formData.append('file', file);

          const csrfToken = document.querySelector(
            'input[name="csrf-token"]',
          )?.value;
          if (csrfToken) {
            formData.append('csrf-token', csrfToken);
          }

          const response = await fetch('/api/upload/image', {
            method: 'POST',
            body: formData,
            headers: {
              'X-CSRF-Token': csrfToken || '',
            },
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.error || 'Upload failed');
          }

          // Update preview and hidden input
          featuredImageUrlHidden.value = data.url;
          previewImg.src = data.url;
          previewContainer.classList.remove('hidden');
          imageUrlInput.value = data.url;
        } catch (error) {
          console.error('Upload error:', error);
          imageError.textContent = error.message || 'Failed to upload image';
          imageError.classList.remove('hidden');
        } finally {
          // Reset upload UI
          uploadPlaceholder.classList.remove('hidden');
          uploadProgress.classList.add('hidden');
          fileInput.value = '';
        }
      });
    }

    // Handle URL input
    if (imageUrlInput && featuredImageUrlHidden) {
      imageUrlInput.addEventListener('input', (e) => {
        const url = e.target.value.trim();
        featuredImageUrlHidden.value = url;

        if (url) {
          previewImg.src = url;
          previewContainer.classList.remove('hidden');
        } else {
          previewContainer.classList.add('hidden');
        }
      });
    }

    // Handle remove button
    if (removeBtn) {
      removeBtn.addEventListener('click', () => {
        featuredImageUrlHidden.value = '';
        imageUrlInput.value = '';
        previewContainer.classList.add('hidden');
        if (fileInput) fileInput.value = '';
      });
    }
  });
</script>

