---
/**
 * Dashboard - Edit Post Page
 * Protected page - requires author or admin role
 * Features: TipTap WYSIWYG editor with full formatting support
 */

export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { isAuthor, isAdmin } from '../../../lib/session';
import { ensureCSRFToken } from '../../../lib/csrf';
import { getPostById, getCategories, getTags } from '../../../lib/posts';
import '../../../styles/editor.css';

const user = Astro.locals.user;

// Double-check author/admin access
if (!user || !isAuthor(user)) {
  return Astro.redirect('/403');
}

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/dashboard');
}

// Fetch the post
const postResult = await getPostById(id);

if (!postResult.success || !postResult.post) {
  return Astro.redirect('/404');
}

const post = postResult.post;

// Check authorization: only author or admin can edit
if (post.authorId !== user.id && !isAdmin(user)) {
  return Astro.redirect('/403');
}

const csrfToken = ensureCSRFToken(Astro.cookies);

// Fetch categories and tags for the form
const categories = await getCategories();
const tags = await getTags();

// Format tags for display - extract names from expanded tags
let postTags = '';
if (post.expand?.tags && Array.isArray(post.expand.tags)) {
  postTags = post.expand.tags.map((tag: any) => tag.name).join(', ');
} else if (Array.isArray(post.tags) && post.tags.length > 0) {
  // Fallback if tags weren't expanded (shouldn't happen but just in case)
  postTags = post.tags.join(', ');
}

const postKeywords = Array.isArray(post.seoKeywords)
  ? post.seoKeywords.join(', ')
  : '';
---

<Layout title={`Edit: ${post.title} - Insightful Health`}>
  <div class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Edit Post</h1>
          <p class="mt-2 text-sm text-gray-600">
            Make changes to your blog post.
          </p>
        </div>
        <div class="flex items-center space-x-4">
          {
            post.status === 'published' && (
              <a
                href={`/post/${post.slug}`}
                target="_blank"
                class="text-sm text-gray-600 hover:text-gray-700 font-medium flex items-center"
              >
                <svg
                  class="w-4 h-4 mr-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
                View Post
              </a>
            )
          }
          <a
            href="/dashboard"
            class="text-sm text-emerald-600 hover:text-emerald-700 font-medium flex items-center"
          >
            <svg
              class="w-4 h-4 mr-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to Dashboard
          </a>
        </div>
      </div>

      <!-- Post Status Badge -->
      <div class="mt-4 flex items-center space-x-4">
        <span
          class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
            post.status === 'published'
              ? 'bg-green-100 text-green-800'
              : post.status === 'draft'
                ? 'bg-yellow-100 text-yellow-800'
                : 'bg-red-100 text-red-800'
          }`}
        >
          {post.status.charAt(0).toUpperCase() + post.status.slice(1)}
        </span>
        <span class="text-sm text-gray-500">
          Last updated: {
            new Date(post.updated).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
              hour: '2-digit',
              minute: '2-digit',
            })
          }
        </span>
      </div>
    </div>

    <!-- Alert Messages -->
    <div id="alert-container" class="mb-6 hidden">
      <div id="alert-message" class="p-4 rounded-md"></div>
    </div>

    <!-- Post Form -->
    <form id="edit-post-form" class="space-y-8">
      <input
        type="hidden"
        name="csrf-token"
        id="csrf-token"
        value={csrfToken}
      />
      <input type="hidden" name="post-id" id="post-id" value={post.id} />

      <!-- Title -->
      <div>
        <label for="title" class="block text-sm font-medium text-gray-700">
          Title <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          name="title"
          id="title"
          required
          maxlength="200"
          value={post.title}
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm transition-colors"
          placeholder="Enter your post title"
        />
        <div class="mt-1 flex justify-between items-start">
          <div>
            <p class="text-xs text-gray-500">
              A compelling title that summarizes your post.
            </p>
            <p id="title-error" class="text-xs text-red-500 mt-1 hidden"></p>
          </div>
          <span class="text-xs text-gray-400">
            <span id="title-count">{post.title.length}</span>/200
          </span>
        </div>
      </div>

      <!-- Slug -->
      <div>
        <label for="slug" class="block text-sm font-medium text-gray-700">
          Slug
        </label>
        <div class="mt-1 flex rounded-md shadow-sm">
          <span
            class="inline-flex items-center px-3 rounded-l-md border border-r-0 border-gray-300 bg-gray-50 text-gray-500 text-sm"
          >
            /post/
          </span>
          <input
            type="text"
            name="slug"
            id="slug"
            value={post.slug}
            class="flex-1 min-w-0 block w-full rounded-none rounded-r-md border-gray-300 focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm transition-colors"
            placeholder="auto-generated-from-title"
          />
        </div>
        <p class="mt-1 text-xs text-gray-500">
          URL-friendly version of the title. Changing this may break existing
          links.
        </p>
        <p id="slug-error" class="text-xs text-red-500 mt-1 hidden"></p>
      </div>

      <!-- Excerpt -->
      <div>
        <label for="excerpt" class="block text-sm font-medium text-gray-700">
          Excerpt
        </label>
        <textarea
          name="excerpt"
          id="excerpt"
          rows="3"
          maxlength="300"
          class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm transition-colors"
          placeholder="Brief summary of your post...">{post.excerpt}</textarea
        >
        <div class="mt-1 flex justify-between items-start">
          <div>
            <p class="text-xs text-gray-500">
              A short summary shown in post listings.
            </p>
            <p id="excerpt-error" class="text-xs text-red-500 mt-1 hidden"></p>
          </div>
          <span class="text-xs text-gray-400">
            <span id="excerpt-count">{post.excerpt?.length || 0}</span>/300
          </span>
        </div>
      </div>

      <!-- Content -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label for="content" class="block text-sm font-medium text-gray-700">
            Content <span class="text-red-500">*</span>
          </label>
          <!-- Editor Mode Toggle -->
          <div class="flex items-center space-x-2">
            <span class="text-xs text-gray-500">Editor Mode:</span>
            <div class="inline-flex rounded-md shadow-sm" role="group">
              <button
                type="button"
                id="mode-wysiwyg"
                class="editor-mode-btn px-3 py-1 text-xs font-medium rounded-l-md border border-gray-300 bg-emerald-50 text-emerald-700 border-emerald-500"
                title="Visual Editor (WYSIWYG)"
              >
                Visual
              </button>
              <button
                type="button"
                id="mode-markdown"
                class="editor-mode-btn px-3 py-1 text-xs font-medium border-t border-b border-gray-300 bg-white text-gray-700 hover:bg-gray-50"
                title="Markdown Editor"
              >
                Markdown
              </button>
              <button
                type="button"
                id="mode-html"
                class="editor-mode-btn px-3 py-1 text-xs font-medium rounded-r-md border border-gray-300 bg-white text-gray-700 hover:bg-gray-50"
                title="Raw HTML Editor"
              >
                HTML
              </button>
            </div>
          </div>
        </div>
        <div class="mt-1">
          <!-- TipTap Rich Text Editor Container -->
          <div id="editor-wrapper" class="editor-container">
            <!-- Toolbar -->
            <div class="editor-toolbar" id="editor-toolbar">
              <!-- Undo/Redo -->
              <div class="editor-toolbar-group">
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="undo"
                  title="Undo (Ctrl+Z)"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M3 10h10a5 5 0 0 1 5 5v2M3 10l4-4M3 10l4 4"></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="redo"
                  title="Redo (Ctrl+Shift+Z)"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M21 10H11a5 5 0 0 0-5 5v2M21 10l-4-4M21 10l-4 4"
                    ></path>
                  </svg>
                </button>
              </div>

              <div class="editor-toolbar-divider"></div>

              <!-- Text formatting -->
              <div class="editor-toolbar-group">
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="bold"
                  title="Bold (Ctrl+B)"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path
                      d="M6 4h8a4 4 0 0 1 2.646 7.001A4.5 4.5 0 0 1 15.5 20H6V4zm3 3v4h5a1.5 1.5 0 0 0 0-3H9zm0 7v4h6.5a2 2 0 0 0 0-4H9z"
                    ></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="italic"
                  title="Italic (Ctrl+I)"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M15 4H9v2h2.5l-3 12H6v2h6v-2h-2.5l3-12H15V4z"
                    ></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="underline"
                  title="Underline (Ctrl+U)"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M7 5v6a5 5 0 0 0 10 0V5M5 19h14"></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="strike"
                  title="Strikethrough"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M13 9h-2V6h2v3zM13 18h-2v-3h2v3zM4 12h16v2H4v-2z"
                    ></path>
                  </svg>
                </button>
              </div>

              <div class="editor-toolbar-divider"></div>

              <!-- Headings -->
              <div class="editor-toolbar-group">
                <select
                  id="heading-select"
                  class="editor-toolbar-select"
                  title="Heading Level"
                >
                  <option value="paragraph">Paragraph</option>
                  <option value="1">Heading 1</option>
                  <option value="2">Heading 2</option>
                  <option value="3">Heading 3</option>
                  <option value="4">Heading 4</option>
                </select>
              </div>

              <div class="editor-toolbar-divider"></div>

              <!-- Font Family -->
              <div class="editor-toolbar-group">
                <select
                  id="font-family-select"
                  class="editor-toolbar-select"
                  title="Font Family"
                >
                  <option value="">Default Font</option>
                  <option value="Arial, sans-serif">Arial</option>
                  <option value="Georgia, serif">Georgia</option>
                  <option value="'Times New Roman', serif"
                    >Times New Roman</option
                  >
                  <option value="'Courier New', monospace">Courier New</option>
                  <option value="Verdana, sans-serif">Verdana</option>
                  <option value="'Comic Sans MS', cursive">Comic Sans MS</option
                  >
                  <option value="Impact, sans-serif">Impact</option>
                </select>
              </div>

              <div class="editor-toolbar-divider"></div>

              <!-- Font Size -->
              <div class="editor-toolbar-group">
                <select
                  id="font-size-select"
                  class="editor-toolbar-select"
                  title="Font Size"
                >
                  <option value="">Default Size</option>
                  <option value="12px">12px</option>
                  <option value="14px">14px</option>
                  <option value="16px">16px</option>
                  <option value="18px">18px</option>
                  <option value="20px">20px</option>
                  <option value="24px">24px</option>
                  <option value="28px">28px</option>
                  <option value="32px">32px</option>
                  <option value="36px">36px</option>
                </select>
              </div>

              <div class="editor-toolbar-divider"></div>

              <!-- Indent/Outdent -->
              <div class="editor-toolbar-group">
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="outdent"
                  title="Decrease Indent"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M19 12H5M12 19l-7-7 7-7"></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="indent"
                  title="Increase Indent"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                  </svg>
                </button>
              </div>

              <div class="editor-toolbar-divider"></div>

              <!-- Text alignment -->
              <div class="editor-toolbar-group">
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="alignLeft"
                  title="Align Left"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path
                      d="M3 4h18v2H3V4zm0 4h12v2H3V8zm0 4h18v2H3v-2zm0 4h12v2H3v-2zm0 4h18v2H3v-2z"
                    ></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="alignCenter"
                  title="Align Center"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path
                      d="M3 4h18v2H3V4zm3 4h12v2H6V8zm-3 4h18v2H3v-2zm3 4h12v2H6v-2zm-3 4h18v2H3v-2z"
                    ></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="alignRight"
                  title="Align Right"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path
                      d="M3 4h18v2H3V4zm6 4h12v2H9V8zm-6 4h18v2H3v-2zm6 4h12v2H9v-2zm-6 4h18v2H3v-2z"
                    ></path>
                  </svg>
                </button>
              </div>

              <div class="editor-toolbar-divider"></div>

              <!-- Lists -->
              <div class="editor-toolbar-group">
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="bulletList"
                  title="Bullet List"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path
                      d="M8 6h14v2H8V6zm0 5h14v2H8v-2zm0 5h14v2H8v-2zM3 5.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm0 5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm0 5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z"
                    ></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="orderedList"
                  title="Numbered List"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path
                      d="M8 6h14v2H8V6zm0 5h14v2H8v-2zm0 5h14v2H8v-2zM3 5v2h2V5H3zm0 5v2h2v-2H3zm0 5v2h2v-2H3z"
                    ></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="blockquote"
                  title="Blockquote"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6 17h3l2-4V7H5v6h3l-2 4zm8 0h3l2-4V7h-6v6h3l-2 4z"
                    ></path>
                  </svg>
                </button>
              </div>

              <div class="editor-toolbar-divider"></div>

              <!-- Code & Links -->
              <div class="editor-toolbar-group">
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="code"
                  title="Inline Code"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M16 18l6-6-6-6M8 6l-6 6 6 6"></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="codeBlock"
                  title="Code Block"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <path d="M8 10l-2 2 2 2M16 10l2 2-2 2M13 7l-2 10"></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="link"
                  title="Insert Link (Ctrl+K)"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                    ></path>
                    <path
                      d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                    ></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="image"
                  title="Insert Image"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <path d="M21 15l-5-5L5 21"></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="youtube"
                  title="Insert YouTube Video"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path
                      d="M21.593 7.203a2.506 2.506 0 0 0-1.762-1.766C18.265 5.007 12 5 12 5s-6.264-.007-7.831.404a2.56 2.56 0 0 0-1.766 1.778c-.413 1.566-.417 4.814-.417 4.814s-.004 3.264.406 4.814c.23.857.905 1.534 1.763 1.765 1.582.43 7.83.437 7.83.437s6.265.007 7.831-.403a2.515 2.515 0 0 0 1.767-1.763c.414-1.565.417-4.812.417-4.812s.02-3.265-.407-4.831zM9.996 15.005l.005-6 5.207 3.005-5.212 2.995z"
                    ></path>
                  </svg>
                </button>
              </div>

              <div class="editor-toolbar-divider"></div>

              <!-- Table -->
              <div class="editor-toolbar-group">
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="table"
                  title="Insert Table"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="3" y1="15" x2="21" y2="15"></line>
                    <line x1="9" y1="3" x2="9" y2="21"></line>
                    <line x1="15" y1="3" x2="15" y2="21"></line>
                  </svg>
                </button>
              </div>

              <!-- Table Operations (shown when cursor is in table) -->
              <div
                id="table-operations"
                class="editor-toolbar-group"
                style="display: none;"
              >
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="addRowBefore"
                  title="Add Row Above"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="9" width="18" height="12" rx="2"></rect>
                    <line x1="12" y1="3" x2="12" y2="6"></line>
                    <line x1="10.5" y1="4.5" x2="13.5" y2="4.5"></line>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="addRowAfter"
                  title="Add Row Below"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="3" width="18" height="12" rx="2"></rect>
                    <line x1="12" y1="18" x2="12" y2="21"></line>
                    <line x1="10.5" y1="19.5" x2="13.5" y2="19.5"></line>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="deleteRow"
                  title="Delete Row"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="8" width="18" height="8" rx="1"></rect>
                    <line x1="7" y1="11" x2="17" y2="13"></line>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="addColumnBefore"
                  title="Add Column Left"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="9" y="3" width="12" height="18" rx="2"></rect>
                    <line x1="3" y1="12" x2="6" y2="12"></line>
                    <line x1="4.5" y1="10.5" x2="4.5" y2="13.5"></line>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="addColumnAfter"
                  title="Add Column Right"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="3" width="12" height="18" rx="2"></rect>
                    <line x1="18" y1="12" x2="21" y2="12"></line>
                    <line x1="19.5" y1="10.5" x2="19.5" y2="13.5"></line>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="deleteColumn"
                  title="Delete Column"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="8" y="3" width="8" height="18" rx="1"></rect>
                    <line x1="11" y1="7" x2="13" y2="17"></line>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="deleteTable"
                  title="Delete Table"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <line x1="8" y1="8" x2="16" y2="16"></line>
                    <line x1="16" y1="8" x2="8" y2="16"></line>
                  </svg>
                </button>
              </div>

              <div class="editor-toolbar-divider"></div>

              <!-- Horizontal Rule -->
              <div class="editor-toolbar-group">
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="hr"
                  title="Horizontal Rule"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M2 11h20v2H2z"></path>
                  </svg>
                </button>
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="clearFormat"
                  title="Clear Formatting"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M7 21l10-18M5 7h9M10 17h9"></path>
                  </svg>
                </button>
              </div>

              <div class="editor-toolbar-divider"></div>

              <!-- Fullscreen -->
              <div class="editor-toolbar-group">
                <button
                  type="button"
                  class="editor-toolbar-btn"
                  data-action="fullscreen"
                  title="Toggle Fullscreen"
                >
                  <svg
                    id="fullscreen-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
                    ></path>
                  </svg>
                </button>
              </div>
            </div>

            <!-- TipTap Editor Content Area -->
            <div class="editor-content" id="editor-content">
              <!-- TipTap will render here -->
            </div>

            <!-- Editor Footer -->
            <div class="editor-footer">
              <div id="editor-status" class="flex items-center space-x-2">
                <span class="text-gray-400">Ready</span>
              </div>
              <div class="flex items-center space-x-4">
                <span><span id="char-count">0</span> characters</span>
                <span><span id="word-count">0</span> words</span>
                <span><span id="reading-time">1</span> min read</span>
              </div>
            </div>
          </div>

          <!-- Markdown Editor (hidden by default) -->
          <div id="markdown-editor-wrapper" class="hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <!-- Markdown Input -->
              <div class="border border-gray-300 rounded-md overflow-hidden">
                <div
                  class="bg-gray-50 px-4 py-2 border-b border-gray-300 flex items-center justify-between"
                >
                  <span class="text-sm font-medium text-gray-700">Markdown</span
                  >
                  <div class="flex items-center space-x-2">
                    <button
                      type="button"
                      class="md-btn text-xs px-2 py-1 rounded bg-gray-200 hover:bg-gray-300"
                      data-md="**"
                      title="Bold"
                    >
                      <strong>B</strong>
                    </button>
                    <button
                      type="button"
                      class="md-btn text-xs px-2 py-1 rounded bg-gray-200 hover:bg-gray-300"
                      data-md="*"
                      title="Italic"
                    >
                      <em>I</em>
                    </button>
                    <button
                      type="button"
                      class="md-btn text-xs px-2 py-1 rounded bg-gray-200 hover:bg-gray-300"
                      data-md="~~"
                      title="Strikethrough"
                    >
                      <s>S</s>
                    </button>
                    <button
                      type="button"
                      class="md-btn text-xs px-2 py-1 rounded bg-gray-200 hover:bg-gray-300"
                      data-md-line="# "
                      title="Heading"
                    >
                      H
                    </button>
                    <button
                      type="button"
                      class="md-btn text-xs px-2 py-1 rounded bg-gray-200 hover:bg-gray-300"
                      data-md="[](url)"
                      title="Link"
                    >
                      🔗
                    </button>
                    <button
                      type="button"
                      class="md-btn text-xs px-2 py-1 rounded bg-gray-200 hover:bg-gray-300"
                      data-md="![alt](url)"
                      title="Image"
                    >
                      🖼
                    </button>
                    <button
                      type="button"
                      class="md-btn text-xs px-2 py-1 rounded bg-gray-200 hover:bg-gray-300"
                      data-md="`"
                      title="Code"
                    >
                      &lt;/&gt;
                    </button>
                  </div>
                </div>
                <textarea
                  id="markdown-input"
                  class="w-full h-96 p-4 font-mono text-sm resize-none focus:outline-none focus:ring-2 focus:ring-emerald-500"
                  placeholder="Write your content in Markdown..."></textarea>
              </div>

              <!-- Markdown Preview -->
              <div class="border border-gray-300 rounded-md overflow-hidden">
                <div class="bg-gray-50 px-4 py-2 border-b border-gray-300">
                  <span class="text-sm font-medium text-gray-700">Preview</span>
                </div>
                <div
                  id="markdown-preview"
                  class="prose prose-emerald max-w-none h-96 p-4 overflow-y-auto bg-white"
                >
                  <p class="text-gray-400 italic">
                    Preview will appear here...
                  </p>
                </div>
              </div>
            </div>

            <!-- Markdown Footer -->
            <div
              class="mt-2 flex items-center justify-between text-xs text-gray-500"
            >
              <span>Supports GitHub Flavored Markdown</span>
              <div class="flex items-center space-x-4">
                <span><span id="md-char-count">0</span> characters</span>
                <span><span id="md-word-count">0</span> words</span>
                <span><span id="md-reading-time">1</span> min read</span>
              </div>
            </div>
          </div>

          <!-- HTML Editor (hidden by default) -->
          <div id="html-editor-wrapper" class="hidden">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <!-- HTML Input -->
              <div class="border border-gray-300 rounded-md overflow-hidden">
                <div
                  class="bg-gray-50 px-4 py-2 border-b border-gray-300 flex items-center justify-between"
                >
                  <span class="text-sm font-medium text-gray-700">HTML</span>
                  <div class="flex items-center space-x-2">
                    <button
                      type="button"
                      id="format-html-btn"
                      class="text-xs px-2 py-1 rounded bg-gray-200 hover:bg-gray-300"
                      title="Format HTML"
                    >
                      Format
                    </button>
                    <button
                      type="button"
                      id="validate-html-btn"
                      class="text-xs px-2 py-1 rounded bg-gray-200 hover:bg-gray-300"
                      title="Validate HTML"
                    >
                      Validate
                    </button>
                  </div>
                </div>
                <textarea
                  id="html-input"
                  class="w-full h-96 p-4 font-mono text-sm resize-none focus:outline-none focus:ring-2 focus:ring-emerald-500"
                  placeholder="Enter raw HTML content..."></textarea>
              </div>

              <!-- HTML Preview -->
              <div class="border border-gray-300 rounded-md overflow-hidden">
                <div
                  class="bg-gray-50 px-4 py-2 border-b border-gray-300 flex items-center justify-between"
                >
                  <span class="text-sm font-medium text-gray-700">Preview</span>
                  <span id="html-validation-status" class="text-xs"></span>
                </div>
                <div
                  id="html-preview"
                  class="prose prose-emerald max-w-none h-96 p-4 overflow-y-auto bg-white"
                >
                  <p class="text-gray-400 italic">
                    Preview will appear here...
                  </p>
                </div>
              </div>
            </div>

            <!-- HTML Footer -->
            <div
              class="mt-2 flex items-center justify-between text-xs text-gray-500"
            >
              <span class="text-yellow-600"
                >⚠️ HTML is sanitized before saving to prevent XSS attacks</span
              >
              <div class="flex items-center space-x-4">
                <span><span id="html-char-count">0</span> characters</span>
                <span><span id="html-word-count">0</span> words</span>
                <span><span id="html-reading-time">1</span> min read</span>
              </div>
            </div>
          </div>

          <!-- Hidden input to store content for form submission -->
          <input
            type="hidden"
            name="content"
            id="content-input"
            value={post.content || ''}
          />
        </div>
        <div class="mt-1 flex justify-between items-start">
          <p class="text-xs text-gray-500">
            Use the toolbar above or keyboard shortcuts for formatting. Switch
            between Visual, Markdown, or HTML mode.
          </p>
          <span class="text-xs text-gray-400">
            <span id="content-char-count">0</span>/50000 chars
          </span>
        </div>
        <p id="content-error" class="text-xs text-red-500 mt-1 hidden"></p>
      </div>

      <!-- Featured Image -->
      <div>
        <label class="block text-sm font-medium text-gray-700">
          Featured Image
        </label>

        <!-- File Upload -->
        <div class="mt-2">
          <div class="flex items-center justify-center w-full">
            <label
              for="featured-image-file"
              class="flex flex-col items-center justify-center w-full h-32 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 transition-colors"
            >
              <div
                class="flex flex-col items-center justify-center pt-5 pb-6"
                id="upload-placeholder"
              >
                <svg
                  class="w-10 h-10 mb-3 text-gray-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
                  ></path>
                </svg>
                <p class="mb-2 text-sm text-gray-500">
                  <span class="font-semibold">Click to upload</span> or drag and drop
                </p>
                <p class="text-xs text-gray-500">
                  PNG, JPG, GIF, WebP (MAX. 5MB)
                </p>
              </div>
              <div class="hidden" id="upload-progress">
                <div class="flex items-center">
                  <svg
                    class="animate-spin h-5 w-5 text-emerald-600 mr-2"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <circle
                      class="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      stroke-width="4"></circle>
                    <path
                      class="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                    ></path>
                  </svg>
                  <span class="text-sm text-gray-600">Uploading...</span>
                </div>
              </div>
              <input
                id="featured-image-file"
                name="featured-image-file"
                type="file"
                class="hidden"
                accept="image/png,image/jpeg,image/jpg,image/gif,image/webp"
              />
            </label>
          </div>
          <p class="mt-1 text-xs text-gray-500">
            Upload an image from your computer
          </p>
        </div>

        <!-- OR Divider -->
        <div class="relative my-4">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-300"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-2 bg-white text-gray-500">OR</span>
          </div>
        </div>

        <!-- Image URL Input -->
        <div class="mt-2">
          <label
            for="image-url-input"
            class="block text-xs font-medium text-gray-600 mb-1"
          >
            Image URL
          </label>
          <input
            type="url"
            id="image-url-input"
            class="block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
            placeholder="https://example.com/image.jpg"
            value={post.featuredImageUrl || ''}
          />
          <p class="mt-1 text-xs text-gray-500">
            Or paste a direct URL to an image
          </p>
        </div>

        <!-- Image Preview -->
        <div
          id="image-preview-container"
          class={post.featuredImageUrl ? 'mt-4' : 'mt-4 hidden'}
        >
          <div class="flex items-start justify-between mb-2">
            <p class="text-xs font-medium text-gray-700">Preview:</p>
            <button
              type="button"
              id="remove-image-btn"
              class="text-xs text-red-600 hover:text-red-800"
            >
              Remove
            </button>
          </div>
          <img
            id="preview-img"
            src={post.featuredImageUrl || ''}
            alt="Preview"
            class="max-h-48 rounded-md border border-gray-200"
          />
        </div>

        <p id="image-error" class="text-xs text-red-500 mt-1 hidden"></p>
        <input
          type="hidden"
          name="featuredImageUrl"
          id="featuredImageUrl"
          value={post.featuredImageUrl || ''}
        />
      </div>

      <!-- Category and Tags -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Category -->
        <div>
          <label for="category" class="block text-sm font-medium text-gray-700">
            Category
          </label>
          <select
            name="category"
            id="category"
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
          >
            <option value="">None</option>
            {
              categories.map((cat) => (
                <option value={cat.id} selected={cat.id === post.categoryId}>
                  {cat.name}
                </option>
              ))
            }
          </select>
          <p class="mt-1 text-xs text-gray-500">
            Categorize your post for better organization.
            {
              categories.length === 0 && (
                <span class="text-yellow-600">
                  {' '}
                  No categories available. Ask an admin to create categories.
                </span>
              )
            }
          </p>
        </div>

        <!-- Tags -->
        <div>
          <label for="tags" class="block text-sm font-medium text-gray-700">
            Tags
          </label>
          <input
            type="text"
            name="tags"
            id="tags"
            value={postTags}
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
            placeholder="e.g., covid-19, vaccines, public-health"
          />
          <p class="mt-1 text-xs text-gray-500">
            Comma-separated list of tags.
          </p>
        </div>
      </div>

      <!-- Status -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Status
        </label>
        <div class="flex items-center space-x-6">
          <div class="flex items-center">
            <input
              id="status-draft"
              name="status"
              type="radio"
              value="draft"
              checked={post.status === 'draft'}
              class="h-4 w-4 text-emerald-600 border-gray-300 focus:ring-emerald-500"
            />
            <label for="status-draft" class="ml-2 text-sm text-gray-700"
              >Draft</label
            >
          </div>
          <div class="flex items-center">
            <input
              id="status-published"
              name="status"
              type="radio"
              value="published"
              checked={post.status === 'published'}
              class="h-4 w-4 text-emerald-600 border-gray-300 focus:ring-emerald-500"
            />
            <label for="status-published" class="ml-2 text-sm text-gray-700"
              >Published</label
            >
          </div>
        </div>
      </div>

      <!-- Featured Toggle (Admin Only) -->
      {
        isAdmin(user) && (
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Featured Post
            </label>
            <div class="flex items-center">
              <input
                id="is-featured"
                name="is-featured"
                type="checkbox"
                checked={post.isFeatured}
                class="h-4 w-4 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500"
              />
              <label for="is-featured" class="ml-2 text-sm text-gray-700">
                Show this post on the homepage featured section
              </label>
            </div>
          </div>
        )
      }

      <!-- SEO Section (Collapsible) -->
      <div class="border border-gray-200 rounded-lg">
        <button
          type="button"
          id="seo-toggle"
          class="w-full flex items-center justify-between p-4 text-left text-gray-700 hover:bg-gray-50"
        >
          <span class="font-medium">SEO Settings</span>
          <svg
            class="w-5 h-5 transform transition-transform"
            id="seo-chevron"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <div
          id="seo-panel"
          class="hidden p-4 border-t border-gray-200 space-y-4"
        >
          <div>
            <label
              for="seo-title"
              class="block text-sm font-medium text-gray-700"
            >
              SEO Title
            </label>
            <input
              type="text"
              name="seo-title"
              id="seo-title"
              maxlength="60"
              value={post.seoTitle || ''}
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm transition-colors"
              placeholder="Custom title for search engines (max 60 chars)"
            />
            <div class="mt-1 flex justify-between items-start">
              <p id="seo-title-error" class="text-xs text-red-500 hidden"></p>
              <span class="text-xs text-gray-400"
                ><span id="seo-title-count">{post.seoTitle?.length || 0}</span
                >/60</span
              >
            </div>
          </div>
          <div>
            <label
              for="seo-description"
              class="block text-sm font-medium text-gray-700"
            >
              Meta Description
            </label>
            <textarea
              name="seo-description"
              id="seo-description"
              rows="2"
              maxlength="160"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm transition-colors"
              placeholder="Custom description for search engines (max 160 chars)"
              >{post.seoDescription || ''}</textarea
            >
            <div class="mt-1 flex justify-between items-start">
              <p id="seo-description-error" class="text-xs text-red-500 hidden">
              </p>
              <span class="text-xs text-gray-400"
                ><span id="seo-description-count"
                  >{post.seoDescription?.length || 0}</span
                >/160</span
              >
            </div>
          </div>
          <div>
            <label
              for="keywords"
              class="block text-sm font-medium text-gray-700"
            >
              Keywords
            </label>
            <input
              type="text"
              name="keywords"
              id="keywords"
              value={postKeywords}
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
              placeholder="keyword1, keyword2, keyword3"
            />
          </div>
          <div>
            <label
              for="canonical-url"
              class="block text-sm font-medium text-gray-700"
            >
              Canonical URL
            </label>
            <input
              type="url"
              name="canonical-url"
              id="canonical-url"
              value={post.canonicalUrl || ''}
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 sm:text-sm"
              placeholder="https://example.com/original-post"
            />
          </div>
        </div>
      </div>

      <!-- Form Actions -->
      <div
        class="flex items-center justify-between pt-6 border-t border-gray-200"
      >
        <div class="flex items-center space-x-4">
          <button
            type="button"
            id="preview-btn"
            class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500"
          >
            Preview
          </button>
          <button
            type="button"
            id="delete-btn"
            class="px-4 py-2 border border-red-300 rounded-md text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
          >
            Delete Post
          </button>
        </div>
        <div class="flex items-center space-x-3">
          <span id="autosave-status" class="text-xs text-gray-400"></span>
          <button
            type="button"
            id="save-draft-btn"
            class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Save as Draft
          </button>
          <button
            type="button"
            id="unpublish-btn"
            class={`px-4 py-2 border border-yellow-300 rounded-md text-sm font-medium text-yellow-700 hover:bg-yellow-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500 disabled:opacity-50 disabled:cursor-not-allowed ${post.status !== 'published' ? 'hidden' : ''}`}
          >
            Unpublish
          </button>
          <button
            type="submit"
            id="submit-btn"
            class="px-6 py-2 bg-emerald-600 text-white text-sm font-medium rounded-md hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {post.status === 'published' ? 'Update Post' : 'Publish Post'}
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="delete-modal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div
      class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0"
    >
      <div
        class="fixed inset-0 transition-opacity bg-gray-500 bg-opacity-75"
        id="delete-backdrop"
      >
      </div>
      <div
        class="inline-block w-full max-w-md px-4 pt-5 pb-4 overflow-hidden text-left align-bottom transition-all transform bg-white rounded-lg shadow-xl sm:my-8 sm:align-middle sm:p-6"
      >
        <div class="sm:flex sm:items-start">
          <div
            class="flex items-center justify-center flex-shrink-0 w-12 h-12 mx-auto bg-red-100 rounded-full sm:mx-0 sm:h-10 sm:w-10"
          >
            <svg
