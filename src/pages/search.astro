---
/**
 * Global Search Page
 * Search across all posts with filters and sorting
 */

export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Pagination from '../components/Pagination.astro';
import { getPocketBase } from '../lib/pocketbase';

// Get query parameters
const url = new URL(Astro.request.url);
const query = url.searchParams.get('q') || '';
const category = url.searchParams.get('category') || '';
const author = url.searchParams.get('author') || '';
const sort = url.searchParams.get('sort') || 'relevance';
const page = parseInt(url.searchParams.get('page') || '1');

const perPage = 20;

// Fetch search results
let searchResults: any[] = [];
let totalItems = 0;
let totalPages = 0;

// Fetch categories and authors for filters
const pb = getPocketBase();
let categories: any[] = [];
let authors: any[] = [];

try {
  [categories, authors] = await Promise.all([
    pb.collection('categories').getFullList({ sort: 'name' }),
    pb.collection('users').getFullList({
      filter: 'role = "author" || role = "admin"',
      sort: 'username',
      fields: 'id,username,fullName',
    }),
  ]);
} catch (error) {
  console.error('Error fetching filters:', error);
}

// Perform search if there's a query
if (query || category || author) {
  try {
    const filters: string[] = ['status = "published"'];

    if (query) {
      const searchConditions: string[] = [];
      searchConditions.push(`title ~ "${query}"`);
      searchConditions.push(`excerpt ~ "${query}"`);
      searchConditions.push(`content ~ "${query}"`);
      filters.push(`(${searchConditions.join(' || ')})`);
    }

    if (category) {
      filters.push(`categoryId = "${category}"`);
    }

    if (author) {
      filters.push(`authorId = "${author}"`);
    }

    const filterString = filters.join(' && ');

    let sortString = '-created';
    switch (sort) {
      case 'date':
        sortString = '-created';
        break;
      case 'oldest':
        sortString = 'created';
        break;
      case 'views':
        sortString = '-viewCount';
        break;
      case 'title':
        sortString = 'title';
        break;
      default:
        sortString = '-created';
    }

    const results = await pb.collection('posts').getList(page, perPage, {
      filter: filterString,
      sort: sortString,
      expand: 'authorId,categoryId',
    });

    searchResults = results.items;
    totalItems = results.totalItems;
    totalPages = results.totalPages;
  } catch (error) {
    console.error('Search error:', error);
  }
}

// Format date
const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

// Highlight search term
const highlightTerm = (text: string, term: string) => {
  if (!text || !term) return text;
  const regex = new RegExp(`(${term})`, 'gi');
  return text.replace(regex, '<mark class="bg-yellow-200">$1</mark>');
};

// Meta title and description
const metaTitle = query
  ? `Search Results for "${query}" | Insightful Health`
  : 'Search | Insightful Health';
const metaDescription = query
  ? `${totalItems} results found for "${query}"`
  : 'Search for public health insights and articles';
---

<Layout title={metaTitle} description={metaDescription}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Search Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Search</h1>

      <!-- Search Form -->
      <form method="get" action="/search" class="mb-6">
        <div class="flex gap-2">
          <input
            type="search"
            name="q"
            value={query}
            placeholder="Search posts, tags, and authors..."
            class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent text-lg"
            autofocus
          />
          <button
            type="submit"
            class="px-6 py-3 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors font-medium"
          >
            Search
          </button>
        </div>

        <!-- Filters -->
        <div class="mt-4 flex flex-wrap gap-4">
          <!-- Category Filter -->
          <div class="flex items-center gap-2">
            <label for="category" class="text-sm font-medium text-gray-700">
              Category:
            </label>
            <select
              name="category"
              id="category"
              class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm"
              onchange="this.form.submit()"
            >
              <option value="">All Categories</option>
              {
                categories.map((cat) => (
                  <option value={cat.id} selected={category === cat.id}>
                    {cat.name}
                  </option>
                ))
              }
            </select>
          </div>

          <!-- Author Filter -->
          <div class="flex items-center gap-2">
            <label for="author" class="text-sm font-medium text-gray-700">
              Author:
            </label>
            <select
              name="author"
              id="author"
              class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm"
              onchange="this.form.submit()"
            >
              <option value="">All Authors</option>
              {
                authors.map((auth) => (
                  <option value={auth.id} selected={author === auth.id}>
                    {auth.fullName || auth.username}
                  </option>
                ))
              }
            </select>
          </div>

          <!-- Sort -->
          <div class="flex items-center gap-2">
            <label for="sort" class="text-sm font-medium text-gray-700">
              Sort by:
            </label>
            <select
              name="sort"
              id="sort"
              class="px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm"
              onchange="this.form.submit()"
            >
              <option value="relevance" selected={sort === 'relevance'}>
                Relevance
              </option>
              <option value="date" selected={sort === 'date'}>Newest First</option>
              <option value="oldest" selected={sort === 'oldest'}>
                Oldest First
              </option>
              <option value="views" selected={sort === 'views'}>Most Views</option>
              <option value="title" selected={sort === 'title'}>Title A-Z</option>
            </select>
          </div>

          <!-- Preserve query in hidden field -->
          {query && <input type="hidden" name="q" value={query} />}

          <!-- Clear Filters -->
          {
            (query || category || author || sort !== 'relevance') && (
              <a
                href="/search"
                class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors"
              >
                Clear All
              </a>
            )
          }
        </div>
      </form>
    </div>

    <!-- Results Count -->
    {
      (query || category || author) && (
        <div class="mb-6">
          <p class="text-gray-600">
            {totalItems === 0 ? (
              <span>No results found</span>
            ) : (
              <span>
                Found <strong class="text-gray-900">{totalItems}</strong>{' '}
                {totalItems === 1 ? 'result' : 'results'}
                {query && (
                  <span>
                    {' '}
                    for "<strong class="text-gray-900">{query}</strong>"
                  </span>
                )}
              </span>
            )}
          </p>
        </div>
      )
    }

    <!-- Search Results -->
    {
      searchResults.length === 0 && (query || category || author) ? (
        <div class="bg-white rounded-lg shadow-sm p-12 text-center">
          <svg
            class="mx-auto h-16 w-16 text-gray-400 mb-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          <h3 class="text-lg font-medium text-gray-900 mb-2">No results found</h3>
          <p class="text-gray-500 mb-4">
            Try adjusting your search or filters to find what you're looking for.
          </p>
          <a
            href="/search"
            class="inline-flex items-center px-4 py-2 bg-emerald-600 text-white rounded-md hover:bg-emerald-700 transition-colors"
          >
            Clear Search
          </a>
        </div>
      ) : searchResults.length > 0 ? (
        <div class="space-y-6">
          {searchResults.map((post: any) => (
            <article class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
              <div class="p-6">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1">
                    <h2 class="text-xl font-semibold text-gray-900 mb-2">
                      <a
                        href={`/posts/${post.slug}`}
                        class="hover:text-emerald-600 transition-colors"
                        set:html={highlightTerm(post.title, query)}
                      />
                    </h2>

                    {post.excerpt && (
                      <p
                        class="text-gray-600 mb-4 line-clamp-2"
                        set:html={highlightTerm(post.excerpt, query)}
                      />
                    )}

                    <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
                      {post.expand?.authorId && (
                        <span class="flex items-center gap-1">
                          <svg
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                            />
                          </svg>
                          {post.expand.authorId.fullName ||
                            post.expand.authorId.username}
                        </span>
                      )}

                      {post.expand?.categoryId && (
                        <a
                          href={`/category/${post.expand.categoryId.slug}`}
                          class="flex items-center gap-1 hover:text-emerald-600 transition-colors"
                        >
                          <svg
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                            />
                          </svg>
                          {post.expand.categoryId.name}
                        </a>
                      )}

                      <span class="flex items-center gap-1">
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                          />
                        </svg>
                        {formatDate(post.created)}
                      </span>

                      {post.viewCount > 0 && (
                        <span class="flex items-center gap-1">
                          <svg
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                            />
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                            />
                          </svg>
                          {post.viewCount}
                        </span>
                      )}

                      {post.commentCount > 0 && (
                        <span class="flex items-center gap-1">
                          <svg
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
                            />
                          </svg>
                          {post.commentCount}
                        </span>
                      )}
                    </div>
                  </div>

                  {post.featuredImage && (
                    <div class="w-24 h-24 flex-shrink-0">
                      <img
                        src={post.featuredImage}
                        alt={post.title}
                        class="w-full h-full object-cover rounded"
                      />
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="bg-white rounded-lg shadow-sm p-12 text-center">
          <svg
            class="mx-auto h-16 w-16 text-gray-400 mb-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          <h3 class="text-lg font-medium text-gray-900 mb-2">
            Start your search
          </h3>
          <p class="text-gray-500">
            Enter a search term to find posts, tags, and authors.
          </p>
        </div>
      )
    }

    <!-- Pagination -->
    {
      totalPages > 1 && (
        <Pagination
          currentPage={page}
          totalPages={totalPages}
          totalItems={totalItems}
          itemsPerPage={perPage}
          baseUrl={`/search?q=${query}${category ? `&category=${category}` : ''}${author ? `&author=${author}` : ''}${sort !== 'relevance' ? `&sort=${sort}` : ''}`}
        />
      )
    }

    <!-- Popular Searches -->
    {
      !query && !category && !author && (
        <div class="mt-12">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">
            Popular Topics
          </h2>
          <div class="flex flex-wrap gap-2">
            <a
              href="/search?q=health"
              class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full hover:bg-emerald-100 hover:text-emerald-700 transition-colors text-sm"
            >
              Health
            </a>
            <a
              href="/search?q=research"
              class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full hover:bg-emerald-100 hover:text-emerald-700 transition-colors text-sm"
            >
              Research
            </a>
            <a
              href="/search?q=wellness"
              class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full hover:bg-emerald-100 hover:text-emerald-700 transition-colors text-sm"
            >
              Wellness
            </a>
            <a
              href="/search?q=nutrition"
              class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full hover:bg-emerald-100 hover:text-emerald-700 transition-colors text-sm"
            >
              Nutrition
            </a>
            <a
              href="/search?q=mental+health"
              class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full hover:bg-emerald-100 hover:text-emerald-700 transition-colors text-sm"
            >
              Mental Health
            </a>
          </div>
        </div>
      )
    }
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // Keyboard shortcut for search (Cmd/Ctrl + K)
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      const searchInput = document.querySelector('input[type="search"]') as HTMLInputElement;
      if (searchInput) {
        searchInput.focus();
        searchInput.select();
      }
    }
  });
</script>
</Layout>
