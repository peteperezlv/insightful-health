---
/**
 * User Profile Page
 * Display and edit user profile information
 */

export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getUserDisplayName } from '../lib/session';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/auth/login');
}
---

<Layout title="Profile">
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Profile</h1>
        <p class="mt-2 text-sm text-gray-600">
          Manage your personal information and profile settings.
        </p>
      </div>

      <!-- Profile Card -->
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <!-- Profile Header -->
        <div
          class="bg-gradient-to-r from-emerald-500 to-emerald-600 px-6 py-12"
        >
          <div class="flex items-center">
            {
              user.avatar ? (
                <img
                  src={user.avatar}
                  alt={getUserDisplayName(user)}
                  class="w-24 h-24 rounded-full border-4 border-white shadow-lg"
                />
              ) : (
                <div class="w-24 h-24 rounded-full border-4 border-white shadow-lg bg-white text-emerald-600 flex items-center justify-center text-3xl font-bold">
                  {getUserDisplayName(user).substring(0, 2).toUpperCase()}
                </div>
              )
            }
            <div class="ml-6">
              <h2 class="text-2xl font-bold text-white">
                {getUserDisplayName(user)}
              </h2>
              <p class="text-emerald-100">{user.email}</p>
              <div class="mt-2">
                <span
                  class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-white text-emerald-700"
                >
                  {user.role || 'user'}
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Profile Details -->
        <div class="px-6 py-6">
          <dl class="divide-y divide-gray-200">
            <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
              <dt class="text-sm font-medium text-gray-500">Email address</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                <div class="flex items-center justify-between">
                  <span>{user.email}</span>
                  {
                    user.verified ? (
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        <svg
                          class="mr-1 w-3 h-3"
                          fill="currentColor"
                          viewBox="0 0 20 20"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        Verified
                      </span>
                    ) : (
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        Not verified
                      </span>
                    )
                  }
                </div>
              </dd>
            </div>

            <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
              <dt class="text-sm font-medium text-gray-500">Username</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                {
                  user.username || (
                    <span class="text-gray-400 italic">Not set</span>
                  )
                }
              </dd>
            </div>

            <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
              <dt class="text-sm font-medium text-gray-500">Full name</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                {
                  user.fullName || (
                    <span class="text-gray-400 italic">Not set</span>
                  )
                }
              </dd>
            </div>

            <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
              <dt class="text-sm font-medium text-gray-500">Role</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                <span class="capitalize">{user.role || 'user'}</span>
              </dd>
            </div>

            <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
              <dt class="text-sm font-medium text-gray-500">User ID</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                <code class="text-xs bg-gray-100 px-2 py-1 rounded"
                  >{user.id}</code
                >
              </dd>
            </div>
          </dl>
        </div>

        <!-- Actions -->
        <div class="bg-gray-50 px-6 py-4 flex justify-end space-x-3">
          <a
            href="/settings"
            class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500"
          >
            Edit Profile
          </a>
        </div>
      </div>

      <!-- Additional Info Card -->
      <div class="mt-6 bg-white shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Quick Links</h3>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <a
            href="/dashboard"
            class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-emerald-500 hover:bg-emerald-50 transition-colors"
          >
            <div class="flex-shrink-0">
              <svg
                class="w-6 h-6 text-emerald-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                ></path>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-900">Dashboard</p>
              <p class="text-sm text-gray-500">View your dashboard</p>
            </div>
          </a>

          <a
            href="/settings"
            class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-emerald-500 hover:bg-emerald-50 transition-colors"
          >
            <div class="flex-shrink-0">
              <svg
                class="w-6 h-6 text-emerald-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-900">Settings</p>
              <p class="text-sm text-gray-500">Manage your account settings</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
