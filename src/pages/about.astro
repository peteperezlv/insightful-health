---
/**
 * About Page
 * Describes Insightful Health's mission and community
 */

export const prerender = false;

import Layout from '../layouts/Layout.astro';
---

<Layout 
	title="About" 
	description="Learn about Insightful Health - bridging the gap between complex health research and everyday understanding through evidence-based analysis and community collaboration."
	keywords="about insightful health, health analytics community, evidence-based health, public health data"
>
	<main id="main-content" class="flex-grow">
		<!-- Hero Section -->
		<section class="bg-gradient-to-br from-emerald-50 via-white to-blue-50 py-16 sm:py-24">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-8 text-center">
					About Insightful Health
				</h1>
				<div class="prose prose-lg max-w-none">
					<div class="bg-white rounded-lg shadow-sm p-8 sm:p-12 space-y-6 text-gray-700 leading-relaxed">
						<p class="text-xl">
							Insightful Health was created to <strong>bridge the gap between complex health research and everyday understanding</strong>. We combine evidence-based analysis, data-driven storytelling, and AI-powered exploration to uncover what truly shapes health outcomes.
						</p>
						
						<p class="text-xl">
							But we're more than a source of information — <strong>we're a community</strong>. Insightful Health brings together curious readers, public health professionals, researchers, and advocates to exchange ideas, challenge assumptions, and learn from one another.
						</p>
						
						<p class="text-xl">
							Whether you're exploring new trends in healthcare AI, digging into public health data, or seeking practical strategies to support well-being, you'll find a space here that values <strong>accuracy, transparency, and collaboration</strong>. Together, we can build a healthier future grounded in knowledge and shared insight.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Mission Section -->
		<section class="py-16 bg-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid md:grid-cols-3 gap-8">
					<!-- Evidence-Based -->
					<div class="text-center p-6">
						<div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
							<svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 mb-2">Evidence-Based</h3>
						<p class="text-gray-600">
							Every insight is grounded in rigorous research and validated data sources.
						</p>
					</div>

					<!-- Data-Driven -->
					<div class="text-center p-6">
						<div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
							<svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
							</svg>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 mb-2">Data-Driven</h3>
						<p class="text-gray-600">
							We transform complex datasets into clear, actionable insights.
						</p>
					</div>

					<!-- Community-Focused -->
					<div class="text-center p-6">
						<div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
							<svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
							</svg>
						</div>
						<h3 class="text-xl font-semibold text-gray-900 mb-2">Community-Focused</h3>
						<p class="text-gray-600">
							A collaborative space for health professionals, researchers, and advocates.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Call to Action -->
		<section class="py-16 bg-emerald-50">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
				<h2 class="text-3xl font-bold text-gray-900 mb-4">
					Join Our Community
				</h2>
				<p class="text-xl text-gray-700 mb-8">
					Start exploring insights, engaging in discussions, and contributing to a healthier future.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a 
						href="/posts" 
						class="px-8 py-3 bg-emerald-600 text-white font-medium rounded-lg hover:bg-emerald-700 transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500"
					>
						Explore Posts
					</a>
					<a 
						href="/auth/signup" 
						class="px-8 py-3 bg-white text-emerald-600 font-medium rounded-lg border-2 border-emerald-600 hover:bg-emerald-50 transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500"
					>
						Sign Up
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
