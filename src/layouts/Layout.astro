---
import '../styles/global.css';
import { getUserDisplayName, getUserInitials } from '../lib/session';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	keywords?: string;
	ogTitle?: string;
	ogDescription?: string;
	url?: string;
}

const { 
	title = 'Insightful Health', 
	description = 'Insights on public health data analytics', 
	canonical, 
	ogImage,
	keywords,
	ogTitle,
	ogDescription,
	url
} = Astro.props;
const fullTitle = title === 'Insightful Health' ? title : `${title} | Insightful Health`;

// Get current user from middleware
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#10b981" />
		
		<!-- SEO -->
		<title>{fullTitle}</title>
		{keywords && <meta name="keywords" content={keywords} />}
		{canonical && <link rel="canonical" href={canonical} />}
		
		<!-- Preconnect to external domains -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		
		<!-- DNS prefetch for performance -->
		<link rel="dns-prefetch" href="https://fonts.googleapis.com" />
		
		<!-- Open Graph -->
		<meta property="og:title" content={ogTitle || fullTitle} />
		<meta property="og:description" content={ogDescription || description} />
		<meta property="og:type" content="website" />
		{ogImage && <meta property="og:image" content={ogImage} />}
		{url && <meta property="og:url" content={url} />}
		<meta property="og:site_name" content="Insightful Health" />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle || fullTitle} />
		<meta name="twitter:description" content={ogDescription || description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		<meta name="twitter:site" content="@InsightfulHealth" />
		<meta name="twitter:creator" content="@InsightfulHealth" />
		
		<!-- Preconnect to critical origins -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		
		<!-- Favicon -->
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		
		<!-- Accessibility -->
		<link rel="sitemap" href="/sitemap.xml" />
		
		<!-- Google Analytics -->
		{import.meta.env.PUBLIC_GA_ID && (
			<>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
				<script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', gaId);
				</script>
			</>
		)}
		
		<!-- Analytics Tracking -->
		<script src="/src/lib/analytics.ts"></script>
		
		<!-- Skip to main content for accessibility -->
		<a href="#main-content" class="skip-link">Skip to main content</a>
	</head>
	<body class="flex flex-col min-h-screen bg-white text-gray-900">
		<!-- Skip to main content link -->
		<a href="#main-content" class="skip-link">Skip to main content</a>
		
		<!-- Navigation Header -->
		<header class="border-b border-gray-200 bg-white sticky top-0 z-40" role="banner">
			<nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4" role="navigation" aria-label="Main navigation">
				<div class="flex items-center justify-between md:justify-between">
					<div class="flex items-center">
						<!-- Mobile Menu Button -->
						<button 
							id="mobile-menu-button"
							class="md:hidden p-2 border border-gray-300 rounded hover:bg-gray-50 focus:outline-none hamburger-menu" 
							aria-label="Toggle mobile menu"
							aria-expanded="false"
							aria-controls="mobile-menu"
						>
							<span></span>
							<span></span>
							<span></span>
						</button>
						
						<!-- Logo -->
						<a 
							href="/" 
							class="flex items-center space-x-2 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded px-2 py-1"
							aria-label="Insightful Health homepage"
						>
							<div class="w-8 h-8 bg-emerald-600 rounded-lg flex items-center justify-center" aria-hidden="true">
								<span class="text-white font-bold text-sm">IH</span>
							</div>
							<span class="hidden sm:inline text-lg font-bold text-gray-900">Insightful Health</span>
						</a>
					</div>

					<!-- Desktop Navigation -->
					<div class="hidden md:flex items-center space-x-6">
						<a href="/posts" class="text-sm font-medium text-gray-700 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded px-2 py-1">Posts</a>
						<a href="/archive" class="text-sm font-medium text-gray-700 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded px-2 py-1">Archive</a>
						<a href="/authors" class="text-sm font-medium text-gray-700 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded px-2 py-1">Authors</a>
						<a href="/about" class="text-sm font-medium text-gray-700 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded px-2 py-1">About</a>
						<a 
							href="/search" 
							class="text-sm font-medium text-gray-700 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded px-2 py-1" 
							aria-label="Search posts"
						>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
							</svg>
							<span class="sr-only">Search</span>
						</a>
					
					{user ? (
						<!-- Authenticated User Menu -->
						<div class="relative" id="user-menu">
							<button 
								type="button"
								id="user-menu-button"
								class="flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded-md p-1"
								aria-haspopup="true"
								aria-expanded="false"
								aria-label="User menu"
							>
								{user?.avatar ? (
									<img src={user.avatar} alt={`${getUserDisplayName(user)} profile picture`} class="w-8 h-8 rounded-full" />
								) : (
									<div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center text-sm font-medium" aria-hidden="true">
										{user && getUserInitials(user)}
									</div>
								)}
								<span class="text-sm font-medium text-gray-700">{user && getUserDisplayName(user)}</span>
								<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
								</svg>
							</button>

								<!-- Dropdown Menu (hidden by default) -->
								<div 
									id="user-menu-dropdown"
									class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 ring-1 ring-black ring-opacity-5"
									role="menu"
									aria-labelledby="user-menu-button"
								>
									<a href="/dashboard" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" role="menuitem">Dashboard</a>
									<a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" role="menuitem">Profile</a>
									<a href="/settings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" role="menuitem">Settings</a>
								{(user?.role === 'author' || user?.role === 'admin') && (
									<a href="/create-post" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" role="menuitem">Create Post</a>
								)}
								{user?.role === 'admin' && (
										<a href="/admin" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" role="menuitem">Admin Panel</a>
									)}
									<div class="border-t border-gray-100 my-1" role="separator"></div>
									<form action="/api/auth/logout" method="POST" class="block">
										<button type="submit" class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-100" role="menuitem">Logout</button>
									</form>
								</div>
							</div>
						) : (
							<!-- Guest User Links -->
							<div class="flex items-center space-x-4">
								<a href="/auth/login" class="text-sm font-medium text-gray-700 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded px-2 py-1">Login</a>
								<a href="/auth/signup" class="px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-md hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500">Sign Up</a>
							</div>
						)}
					</div>
				</div>

				<!-- Mobile Menu (hidden by default) -->
				<div 
					id="mobile-menu" 
					class="menu-closed md:hidden mt-4 pb-4 border-t border-gray-200 pt-4"
					role="navigation"
					aria-label="Mobile navigation"
				>
					<div class="flex flex-col space-y-1">
						<a href="/posts" class="text-sm font-medium text-gray-700 hover:text-emerald-600 px-2 py-1">Posts</a>
						<a href="/archive" class="text-sm font-medium text-gray-700 hover:text-emerald-600 px-2 py-1">Archive</a>
						<a href="/authors" class="text-sm font-medium text-gray-700 hover:text-emerald-600 px-2 py-1">Authors</a>
						<a href="/about" class="text-sm font-medium text-gray-700 hover:text-emerald-600 px-2 py-1">About</a>
					<a href="/search" class="text-sm font-medium text-gray-700 hover:text-emerald-600 px-2 py-1">Search</a>
					
					{user ? (
						<>
							<div class="border-t border-gray-200 my-2"></div>
							<a href="/dashboard" class="text-sm font-medium text-gray-700 hover:text-emerald-600 px-2 py-1">Dashboard</a>
							<a href="/profile" class="text-sm font-medium text-gray-700 hover:text-emerald-600 px-2 py-1">Profile</a>
							<a href="/settings" class="text-sm font-medium text-gray-700 hover:text-emerald-600 px-2 py-1">Settings</a>
							{(user?.role === 'author' || user?.role === 'admin') && (
								<a href="/create-post" class="text-sm font-medium text-gray-700 hover:text-emerald-600 px-2 py-1">Create Post</a>
							)}
							{user?.role === 'admin' && (
									<a href="/admin" class="text-sm font-medium text-gray-700 hover:text-emerald-600 px-2 py-1">Admin Panel</a>
								)}
								<form action="/api/auth/logout" method="POST">
									<button type="submit" class="text-sm font-medium text-red-600 hover:text-red-700 px-2 py-1">Logout</button>
								</form>
							</>
						) : (
							<>
								<div class="border-t border-gray-200 my-2"></div>
								<a href="/auth/login" class="text-sm font-medium text-gray-700 hover:text-emerald-600 px-2 py-1">Login</a>
								<a href="/auth/signup" class="inline-block px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-md hover:bg-emerald-700 text-center">Sign Up</a>
							</>
						)}
					</div>
				</div>
			</nav>
		</header>

		<script is:inline>
			// Initialize menu functionality immediately or when DOM is ready
			function initializeMenus() {
				console.log('Initializing menus...');
				
				// User menu dropdown toggle
				const userMenuButton = document.getElementById('user-menu-button');
				const userMenuDropdown = document.getElementById('user-menu-dropdown');
				
				console.log('User menu elements:', { button: userMenuButton, dropdown: userMenuDropdown });
				if (userMenuButton && userMenuDropdown) {
					userMenuButton.addEventListener('click', (e) => {
						e.stopPropagation();
						const isHidden = userMenuDropdown.classList.contains('hidden');
						userMenuDropdown.classList.toggle('hidden');
						userMenuButton.setAttribute('aria-expanded', String(!isHidden));
					});

					// Close dropdown when clicking outside
					document.addEventListener('click', (e) => {
						if (!userMenuDropdown.classList.contains('hidden')) {
							if (!userMenuButton.contains(e.target) && !userMenuDropdown.contains(e.target)) {
								userMenuDropdown.classList.add('hidden');
								userMenuButton.setAttribute('aria-expanded', 'false');
							}
						}
					});

					// Close dropdown on escape key
					document.addEventListener('keydown', (e) => {
						if (e.key === 'Escape' && !userMenuDropdown.classList.contains('hidden')) {
							userMenuDropdown.classList.add('hidden');
							userMenuButton.setAttribute('aria-expanded', 'false');
							userMenuButton.focus();
						}
					});
				}

				// Mobile menu toggle
				const mobileMenuButton = document.getElementById('mobile-menu-button');
				const mobileMenu = document.getElementById('mobile-menu');
				
				if (mobileMenuButton && mobileMenu) {
					console.log('Mobile menu elements found:', { button: mobileMenuButton, menu: mobileMenu });
					
					mobileMenuButton.addEventListener('click', function(e) {
						e.preventDefault();
						e.stopPropagation();
						
						console.log('Button clicked!');
						console.log('Current classes:', mobileMenu.className);
						
						const isClosed = mobileMenu.classList.contains('menu-closed');
						console.log('Menu is currently closed:', isClosed);
						
						if (isClosed) {
							mobileMenu.classList.remove('menu-closed', 'hidden');
							mobileMenu.classList.add('menu-open');
							mobileMenuButton.classList.add('active');
							mobileMenuButton.setAttribute('aria-expanded', 'true');
							console.log('Opening menu');
						} else {
							mobileMenu.classList.remove('menu-open');
							mobileMenu.classList.add('menu-closed');
							mobileMenuButton.classList.remove('active');
							mobileMenuButton.setAttribute('aria-expanded', 'false');
							console.log('Closing menu');
						}
						
						console.log('New classes:', mobileMenu.className);
					});
					
					// Close mobile menu when clicking outside
					document.addEventListener('click', (e) => {
						if (!mobileMenuButton.contains(e.target) && !mobileMenu.contains(e.target)) {
							mobileMenu.classList.remove('menu-open');
							mobileMenu.classList.add('menu-closed');
							mobileMenuButton.classList.remove('active');
							mobileMenuButton.setAttribute('aria-expanded', 'false');
						}
					});
					
					// Close mobile menu when clicking on a link
					const mobileMenuLinks = mobileMenu.querySelectorAll('a');
					mobileMenuLinks.forEach(link => {
						link.addEventListener('click', () => {
							mobileMenu.classList.remove('menu-open');
							mobileMenu.classList.add('menu-closed');
							mobileMenuButton.classList.remove('active');
							mobileMenuButton.setAttribute('aria-expanded', 'false');
						});
					});
				} else {
					console.log('Mobile menu elements not found');
				}
			}
			
			// Run initialization when DOM is ready
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initializeMenus);
			} else {
				// DOM is already loaded
				initializeMenus();
			}
			
			// Also handle page navigation for Astro view transitions
			document.addEventListener('astro:page-load', initializeMenus);
		</script>

		<!-- Main Content -->
		<main id="main-content" class="flex-1 w-full">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="border-t border-gray-200 bg-gray-50 mt-16" role="contentinfo">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
					<div>
						<h3 class="text-sm font-semibold text-gray-900 mb-4">About</h3>
						<p class="text-sm text-gray-600">Insightful Health is a platform for sharing public health insights and data analytics.</p>
					</div>
					<nav aria-label="Footer resources">
						<h3 class="text-sm font-semibold text-gray-900 mb-4">Resources</h3>
						<ul class="space-y-2">
							<li><a href="/posts" class="text-sm text-gray-600 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded">All Posts</a></li>
							<li><a href="/archive" class="text-sm text-gray-600 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded">Archive</a></li>
							<li><a href="/authors" class="text-sm text-gray-600 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded">Authors</a></li>
						</ul>
					</nav>
					<nav aria-label="Footer legal">
						<h3 class="text-sm font-semibold text-gray-900 mb-4">Legal</h3>
						<ul class="space-y-2">
							<li><a href="/privacy" class="text-sm text-gray-600 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded">Privacy</a></li>
							<li><a href="/terms" class="text-sm text-gray-600 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded">Terms</a></li>
							<li><a href="/accessibility" class="text-sm text-gray-600 hover:text-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded">Accessibility</a></li>
						</ul>
					</nav>
					<div>
						<h3 class="text-sm font-semibold text-gray-900 mb-4">Connect</h3>
						<p class="text-sm text-gray-600 mb-4">Subscribe to our newsletter for health insights.</p>
						<form class="flex" onsubmit="event.preventDefault()" aria-label="Newsletter subscription">
							<label for="footer-email" class="sr-only">Email address</label>
							<input 
								type="email" 
								id="footer-email"
								name="email"
								placeholder="Your email" 
								autocomplete="email"
								required
								aria-required="true"
								class="flex-1 px-3 py-2 text-sm border border-gray-300 rounded-l focus:outline-none focus:ring-2 focus:ring-emerald-500 min-h-[44px]" 
							/>
							<button type="submit" class="px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-r hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 min-h-[44px]">
								Subscribe
							</button>
						</form>
					</div>
				</div>
				<div class="border-t border-gray-200 pt-8">
					<p class="text-sm text-gray-600 text-center">&copy; 2025 Insightful Health. All rights reserved.</p>
				</div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	/* Smooth scrolling */
	html {
		scroll-behavior: smooth;
	}

	/* Remove default focus outline */
	:focus {
		outline: none;
	}

	/* Better focus styles */
	button:focus-visible,
	a:focus-visible,
	input:focus-visible {
		outline: 2px solid #5aa08f;
		outline-offset: 2px;
	}
</style>

<script>
	// Mobile menu toggle
	const mobileMenuButton = document.getElementById('mobile-menu-button');
	const mobileMenu = document.getElementById('mobile-menu');

	if (mobileMenuButton && mobileMenu) {
		mobileMenuButton.addEventListener('click', () => {
			const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
			mobileMenuButton.setAttribute('aria-expanded', String(!isExpanded));
			mobileMenu.classList.toggle('hidden');
		});

		// Close mobile menu when clicking outside
		document.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (!mobileMenu.classList.contains('hidden') && 
				!mobileMenu.contains(target) && 
				!mobileMenuButton.contains(target)) {
				mobileMenu.classList.add('hidden');
				mobileMenuButton.setAttribute('aria-expanded', 'false');
			}
		});
	}
</script>
