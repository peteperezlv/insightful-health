---
/**
 * Reusable Pagination Component
 * Handles navigation through paginated data
 */

export interface Props {
  currentPage: number;
  totalPages: number;
  totalItems: number;
  itemsPerPage: number;
  baseUrl: string;
}

const { currentPage, totalPages, totalItems, itemsPerPage, baseUrl } = Astro.props;

// Calculate page range to display (show 5 pages at a time)
const getPageRange = (current: number, total: number) => {
  const delta = 2; // Show 2 pages on each side of current
  const range: number[] = [];
  const rangeWithDots: (number | string)[] = [];

  for (
    let i = Math.max(2, current - delta);
    i <= Math.min(total - 1, current + delta);
    i++
  ) {
    range.push(i);
  }

  if (current - delta > 2) {
    rangeWithDots.push(1, '...');
  } else {
    rangeWithDots.push(1);
  }

  rangeWithDots.push(...range);

  if (current + delta < total - 1) {
    rangeWithDots.push('...', total);
  } else if (total > 1) {
    rangeWithDots.push(total);
  }

  return rangeWithDots;
};

const pageRange = totalPages > 1 ? getPageRange(currentPage, totalPages) : [];

// Calculate showing items range
const startItem = (currentPage - 1) * itemsPerPage + 1;
const endItem = Math.min(currentPage * itemsPerPage, totalItems);

// Build URL with page parameter
const buildPageUrl = (page: number) => {
  const url = new URL(baseUrl, Astro.url.origin);
  url.searchParams.set('page', page.toString());
  return url.pathname + url.search;
};
---

<div class="pagination-container">
  {totalItems > 0 && (
    <div class="pagination-info">
      <p class="text-sm text-gray-600">
        Showing <span class="font-semibold text-gray-900">{startItem}</span> to{' '}
        <span class="font-semibold text-gray-900">{endItem}</span> of{' '}
        <span class="font-semibold text-gray-900">{totalItems}</span> results
      </p>
    </div>
  )}

  {totalPages > 1 && (
    <nav class="pagination-nav" aria-label="Pagination">
      <ul class="pagination-list">
        <!-- Previous Button -->
        <li>
          {currentPage > 1 ? (
            <a
              href={buildPageUrl(currentPage - 1)}
              class="pagination-button"
              aria-label="Go to previous page"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              Previous
            </a>
          ) : (
            <span class="pagination-button pagination-button-disabled">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              Previous
            </span>
          )}
        </li>

        <!-- Page Numbers -->
        {pageRange.map((page) => (
          <li>
            {page === '...' ? (
              <span class="pagination-ellipsis">...</span>
            ) : page === currentPage ? (
              <span class="pagination-current" aria-current="page">
                {page}
              </span>
            ) : (
              <a
                href={buildPageUrl(page as number)}
                class="pagination-number"
                aria-label={`Go to page ${page}`}
              >
                {page}
              </a>
            )}
          </li>
        ))}

        <!-- Next Button -->
        <li>
          {currentPage < totalPages ? (
            <a
              href={buildPageUrl(currentPage + 1)}
              class="pagination-button"
              aria-label="Go to next page"
            >
              Next
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          ) : (
            <span class="pagination-button pagination-button-disabled">
              Next
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
            </span>
          )}
        </li>
      </ul>
    </nav>
  )}
</div>

<style>
  .pagination-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    background-color: white;
    border-top: 1px solid rgb(229 231 235);
  }

  @media (min-width: 640px) {
    .pagination-container {
      flex-direction: row;
    }
  }

  .pagination-info {
    flex: 1 1 0%;
  }

  .pagination-nav {
    flex: 1 1 0%;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .pagination-nav {
      justify-content: flex-end;
    }
  }

  .pagination-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .pagination-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: rgb(55 65 81);
    background-color: white;
    border: 1px solid rgb(209 213 219);
    border-radius: 0.375rem;
    transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
    transition-duration: 150ms;
  }

  .pagination-button:hover {
    background-color: rgb(249 250 251);
  }

  .pagination-button:focus {
    z-index: 10;
    outline: 2px solid transparent;
    outline-offset: 2px;
    box-shadow: 0 0 0 2px white, 0 0 0 4px rgb(16 185 129);
  }

  .pagination-button-disabled {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: rgb(156 163 175);
    background-color: rgb(249 250 251);
    border: 1px solid rgb(209 213 219);
    border-radius: 0.375rem;
    cursor: not-allowed;
  }

  .pagination-number {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: rgb(55 65 81);
    background-color: white;
    border: 1px solid rgb(209 213 219);
    transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
    transition-duration: 150ms;
  }

  .pagination-number:hover {
    background-color: rgb(249 250 251);
  }

  .pagination-number:focus {
    z-index: 10;
    outline: 2px solid transparent;
    outline-offset: 2px;
    box-shadow: 0 0 0 2px white, 0 0 0 4px rgb(16 185 129);
  }

  .pagination-current {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
    color: white;
    background-color: rgb(16 185 129);
    border: 1px solid rgb(16 185 129);
    cursor: default;
  }

  .pagination-ellipsis {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: rgb(55 65 81);
  }
</style>
