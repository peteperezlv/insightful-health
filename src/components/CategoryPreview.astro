---
/**
 * Category Preview Component
 * Displays top categories with post counts
 */
interface Category {
  id: string;
  name: string;
  slug: string;
  description?: string;
  postCount?: number;
}

interface Props {
  categories: Category[];
  maxDisplay?: number;
}

const { categories, maxDisplay = 6 } = Astro.props;
const displayCategories = categories.slice(0, maxDisplay);
---

<section class="bg-gray-50 rounded-lg p-8">
  <div class="text-center mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Explore Categories</h2>
    <p class="text-gray-600">Browse articles by topic</p>
  </div>
  
  {displayCategories.length === 0 ? (
    <p class="text-gray-500 text-center">No categories available yet.</p>
  ) : (
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      {displayCategories.map((category) => (
        <a 
          href={`/category/${category.slug}`}
          class="group bg-white rounded-lg p-4 text-center hover:shadow-lg hover:border-emerald-500 border-2 border-transparent transition-all duration-200 transform hover:-translate-y-1"
        >
          <div class="mb-2">
            <svg class="w-8 h-8 mx-auto text-emerald-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900 mb-1 group-hover:text-emerald-600 transition-colors text-sm">
            {category.name}
          </h3>
          {category.postCount !== undefined && (
            <p class="text-xs text-gray-500">
              {category.postCount} {category.postCount === 1 ? 'post' : 'posts'}
            </p>
          )}
        </a>
      ))}
    </div>
  )}
  
  {categories.length > maxDisplay && (
    <div class="text-center mt-6">
      <a 
        href="/categories"
        class="inline-flex items-center gap-2 text-emerald-600 font-medium hover:text-emerald-700 transition-colors"
      >
        View All Categories
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  )}
</section>
