---
/**
 * CommentList Component
 * Displays comments with nested replies and threading
 */

interface Props {
  postId: string;
}

const { postId } = Astro.props;
---

<div class="comments-section">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
      Comments <span id="comment-count" class="text-gray-500 dark:text-gray-400 text-lg"></span>
    </h2>
    
    <button
      id="refresh-comments"
      class="text-emerald-600 hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300 font-medium text-sm"
    >
      <svg class="w-5 h-5 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
      Refresh
    </button>
  </div>

  <!-- Loading state -->
  <div id="comments-loading" class="text-center py-8">
    <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-gray-200 border-t-emerald-600"></div>
    <p class="text-gray-600 dark:text-gray-400 mt-2">Loading comments...</p>
  </div>

  <!-- Error state -->
  <div id="comments-error" class="hidden">
    <div class="bg-red-50 dark:bg-red-900 border border-red-200 dark:border-red-700 rounded-lg p-4">
      <p class="text-red-700 dark:text-red-200" id="error-text"></p>
    </div>
  </div>

  <!-- Empty state -->
  <div id="comments-empty" class="hidden text-center py-8">
    <svg class="w-16 h-16 mx-auto text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
    </svg>
    <p class="text-gray-600 dark:text-gray-400 mt-4">No comments yet. Be the first to comment!</p>
  </div>

  <!-- Comments container -->
  <div id="comments-container" class="space-y-6"></div>

  <!-- Pagination -->
  <div id="comments-pagination" class="hidden mt-6 flex justify-center gap-2">
    <button
      id="load-more"
      class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-6 py-2 rounded-lg transition-colors duration-200"
    >
      Load More Comments
    </button>
  </div>
</div>

<!-- Comment Template -->
<template id="comment-template">
  <div class="comment-item" data-comment-id="">
    <div class="flex gap-4">
      <!-- Avatar -->
      <div class="flex-shrink-0">
        <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-900 flex items-center justify-center">
          <span class="text-emerald-600 dark:text-emerald-400 font-semibold comment-avatar"></span>
        </div>
      </div>

      <!-- Comment content -->
      <div class="flex-1 min-w-0">
        <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="font-semibold text-gray-900 dark:text-white comment-author"></span>
              <span class="text-xs text-gray-500 dark:text-gray-400 comment-date"></span>
              <span class="comment-edited hidden text-xs text-gray-500 dark:text-gray-400">(edited)</span>
            </div>
            
            <!-- Action buttons -->
            <div class="comment-actions flex gap-2">
              <button class="edit-comment hidden text-sm text-blue-600 hover:text-blue-700 dark:text-blue-400">
                Edit
              </button>
              <button class="delete-comment hidden text-sm text-red-600 hover:text-red-700 dark:text-red-400">
                Delete
              </button>
            </div>
          </div>

          <div class="comment-content text-gray-700 dark:text-gray-300 whitespace-pre-wrap"></div>
          
          <!-- Collapse button for long comments -->
          <button class="collapse-comment hidden text-sm text-emerald-600 hover:text-emerald-700 mt-2">
            Show less
          </button>
        </div>

        <!-- Reply button -->
        <div class="mt-2 flex items-center gap-4">
          <button class="reply-button text-sm text-emerald-600 hover:text-emerald-700 dark:text-emerald-400 font-medium">
            Reply
          </button>
        </div>

        <!-- Reply form container -->
        <div class="reply-form-container mt-4 hidden"></div>

        <!-- Nested replies -->
        <div class="replies-container ml-6 mt-4 space-y-4 border-l-2 border-gray-200 dark:border-gray-600 pl-4"></div>
      </div>
    </div>
  </div>
</template>

<script define:vars={{ postId }}>
  let allComments = [];
  let currentPage = 1;
  const commentsPerPage = 20;

  const container = document.getElementById('comments-container');
  const loading = document.getElementById('comments-loading');
  const error = document.getElementById('comments-error');
  const errorText = document.getElementById('error-text');
  const empty = document.getElementById('comments-empty');
  const commentCount = document.getElementById('comment-count');
  const pagination = document.getElementById('comments-pagination');
  const loadMoreBtn = document.getElementById('load-more');
  const refreshBtn = document.getElementById('refresh-comments');
  const template = document.getElementById('comment-template');

  // Load comments
  async function loadComments() {
    try {
      loading.classList.remove('hidden');
      error.classList.add('hidden');
      empty.classList.add('hidden');
      container.innerHTML = '';

      const response = await fetch(`/api/comments?postId=${postId}`);
      
      if (!response.ok) {
        throw new Error('Failed to load comments');
      }

      const data = await response.json();
      allComments = data.comments || [];

      loading.classList.add('hidden');

      if (allComments.length === 0) {
        empty.classList.remove('hidden');
        commentCount.textContent = '(0)';
      } else {
        commentCount.textContent = `(${allComments.length})`;
        renderComments();
      }
    } catch (err) {
      console.error('Load comments error:', err);
      loading.classList.add('hidden');
      error.classList.remove('hidden');
      errorText.textContent = err.message || 'Failed to load comments';
    }
  }

  // Render comments with threading
  function renderComments() {
    container.innerHTML = '';
    
    // Build comment tree
    const commentMap = new Map();
    const topLevelComments = [];

    // First pass: create map
    allComments.forEach(comment => {
      commentMap.set(comment.id, { ...comment, replies: [] });
    });

    // Second pass: build tree
    allComments.forEach(comment => {
      const commentNode = commentMap.get(comment.id);
      if (comment.parentCommentId && commentMap.has(comment.parentCommentId)) {
        commentMap.get(comment.parentCommentId).replies.push(commentNode);
      } else {
        topLevelComments.push(commentNode);
      }
    });

    // Sort top-level comments by date (newest first)
    topLevelComments.sort((a, b) => new Date(b.created) - new Date(a.created));

    // Render each top-level comment
    topLevelComments.forEach(comment => {
      const element = renderComment(comment);
      container.appendChild(element);
    });
  }

  // Render a single comment with its replies
  function renderComment(comment, depth = 0) {
    const clone = template.content.cloneNode(true);
    const item = clone.querySelector('.comment-item');
    
    item.dataset.commentId = comment.id;
    item.dataset.authorId = comment.authorId || '';

    // Set avatar (first letter of name)
    const avatar = clone.querySelector('.comment-avatar');
    avatar.textContent = (comment.authorName || 'A')[0].toUpperCase();

    // Set author name
    const authorName = clone.querySelector('.comment-author');
    authorName.textContent = comment.authorName || 'Anonymous';

    // Set date
    const date = clone.querySelector('.comment-date');
    date.textContent = formatDate(comment.created);

    // Show edited indicator
    if (comment.isEdited) {
      clone.querySelector('.comment-edited').classList.remove('hidden');
    }

    // Set content
    const content = clone.querySelector('.comment-content');
    const fullContent = comment.content;
    const isLong = fullContent.length > 500;
    
    if (isLong) {
      content.textContent = fullContent.substring(0, 500) + '...';
      const collapseBtn = clone.querySelector('.collapse-comment');
      collapseBtn.classList.remove('hidden');
      collapseBtn.textContent = 'Show more';
      
      let expanded = false;
      collapseBtn.addEventListener('click', () => {
        expanded = !expanded;
        content.textContent = expanded ? fullContent : fullContent.substring(0, 500) + '...';
        collapseBtn.textContent = expanded ? 'Show less' : 'Show more';
      });
    } else {
      content.textContent = fullContent;
    }

    // Show edit/delete buttons if user owns comment
    checkCommentOwnership(comment.id, comment.authorId).then(isOwner => {
      if (isOwner) {
        clone.querySelector('.edit-comment').classList.remove('hidden');
        clone.querySelector('.delete-comment').classList.remove('hidden');
      }
    });

    // Reply button
    const replyBtn = clone.querySelector('.reply-button');
    const replyContainer = clone.querySelector('.reply-form-container');
    
    replyBtn.addEventListener('click', () => {
      showReplyForm(comment.id, replyContainer, replyBtn);
    });

    // Edit button
    clone.querySelector('.edit-comment')?.addEventListener('click', () => {
      editComment(comment.id, fullContent);
    });

    // Delete button
    clone.querySelector('.delete-comment')?.addEventListener('click', () => {
      deleteComment(comment.id);
    });

    // Render nested replies
    if (comment.replies && comment.replies.length > 0) {
      const repliesContainer = clone.querySelector('.replies-container');
      comment.replies.sort((a, b) => new Date(a.created) - new Date(b.created));
      
      comment.replies.forEach(reply => {
        const replyElement = renderComment(reply, depth + 1);
        repliesContainer.appendChild(replyElement);
      });
    }

    return clone;
  }

  // Show reply form
  async function showReplyForm(parentCommentId, container, button) {
    // Hide all other reply forms
    document.querySelectorAll('.reply-form-container').forEach(el => {
      el.classList.add('hidden');
      el.innerHTML = '';
    });

    container.classList.remove('hidden');
    
    // Dynamically import CommentForm
    container.innerHTML = `
      <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 border-2 border-emerald-500">
        <h4 class="text-sm font-semibold mb-3 text-gray-700 dark:text-gray-300">Reply to comment</h4>
        <div id="reply-form-${parentCommentId}"></div>
      </div>
    `;

    // Note: In a real implementation, you'd dynamically load the CommentForm component
    // For now, we'll just trigger a page event
    window.dispatchEvent(new CustomEvent('show-reply-form', { 
      detail: { parentCommentId, containerId: `reply-form-${parentCommentId}` }
    }));

    // Setup cancel function
    window.cancelReply = () => {
      container.classList.add('hidden');
      container.innerHTML = '';
    };
  }

  // Check if current user owns comment
  async function checkCommentOwnership(commentId, authorId) {
    try {
      const response = await fetch('/api/auth/me');
      if (response.ok) {
        const data = await response.json();
        return data.user && (data.user.id === authorId || data.user.role === 'admin');
      }
    } catch (error) {
      console.error('Auth check failed:', error);
    }
    return false;
  }

  // Edit comment
  async function editComment(commentId, currentContent) {
    const newContent = prompt('Edit your comment:', currentContent);
    
    if (newContent && newContent.trim() !== currentContent) {
      try {
        const response = await fetch(`/api/comments/${commentId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: newContent.trim() }),
        });

        const data = await response.json();

        if (response.ok) {
          alert('Comment updated and re-submitted for moderation');
          loadComments();
        } else {
          alert(data.error || 'Failed to update comment');
        }
      } catch (error) {
        console.error('Edit error:', error);
        alert('An error occurred while updating the comment');
      }
    }
  }

  // Delete comment
  async function deleteComment(commentId) {
    if (!confirm('Are you sure you want to delete this comment?')) {
      return;
    }

    try {
      const response = await fetch(`/api/comments/${commentId}`, {
        method: 'DELETE',
      });

      const data = await response.json();

      if (response.ok) {
        alert('Comment deleted successfully');
        loadComments();
      } else {
        alert(data.error || 'Failed to delete comment');
      }
    } catch (error) {
      console.error('Delete error:', error);
      alert('An error occurred while deleting the comment');
    }
  }

  // Format date
  function formatDate(dateString) {
    const date = new Date(dateString);
    const now = new Date();
    const diffMs = now - date;
    const diffMins = Math.floor(diffMs / 60000);
    const diffHours = Math.floor(diffMs / 3600000);
    const diffDays = Math.floor(diffMs / 86400000);

    if (diffMins < 1) return 'Just now';
    if (diffMins < 60) return `${diffMins}m ago`;
    if (diffHours < 24) return `${diffHours}h ago`;
    if (diffDays < 7) return `${diffDays}d ago`;
    
    return date.toLocaleDateString('en-US', { 
      month: 'short', 
      day: 'numeric',
      year: date.getFullYear() !== now.getFullYear() ? 'numeric' : undefined 
    });
  }

  // Refresh button
  refreshBtn.addEventListener('click', loadComments);

  // Listen for new comments
  window.addEventListener('comment-submitted', () => {
    setTimeout(loadComments, 1000);
  });

  // Initial load
  loadComments();
</script>

<style>
  .comment-item {
    animation: fadeIn 0.3s ease-in;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .replies-container:empty {
    display: none;
  }
</style>
